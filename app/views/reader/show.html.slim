- content_for(:title, @text.title)

.py-6.space-y-5
  = link_to reader_path, class: "inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground" do
    span ←
    span = t("reader.back")

  header.space-y-2
    .flex.flex-wrap.items-start.justify-between.gap-3
      .min-w-0.space-y-1
        h1.text-2xl.font-bold.tracking-tight = @text.title
        p.text-sm.text-muted-foreground
          = t("reader.tabs.#{@text.kind}")
          - if @text.author.present?
            span.mx-1 ·
            = @text.author
          - if @text.level_tag.present?
            span.mx-1 ·
            = @text.level_tag
      .flex.shrink-0.flex-wrap.gap-2
        - if @text.collection
          = link_to t("desks.study"), study_path(mode: "desk", collection_id: @text.collection_id), class: "rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
          = link_to t("desks.open"), my_desk_path(@text.collection), class: "rounded-lg border border-border px-3 py-2 text-sm font-medium hover:bg-muted"
        - else
          = button_to t("reader.build_desk"), reader_text_desk_path(@text), class: "rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"

    - if @text.changed_characters.any?
      p.rounded-lg.border.border-border.px-3.py-2.text-xs.text-muted-foreground
        = t("reader.normalized_hint", chars: @text.changed_characters.first(12).join(" "))

  p.flex.flex-wrap.gap-x-4.gap-y-1.text-xs.text-muted-foreground
    span = t("reader.legend_known")
    span = t("reader.legend_unknown")

  = render("shared/annotated_text", lines: @lines, known_ids: @known_ids)

  - if @text.attribution.present?
    p.text-xs.text-muted-foreground = @text.attribution

  = button_to t("common.delete"), reader_text_path(@text), method: :delete, form: {data: {turbo_confirm: t("reader.delete_confirm")}}, class: "rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground hover:bg-muted"
