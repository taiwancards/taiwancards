- content_for(:title, t("reader.title"))

.py-6.space-y-5
  header.flex.flex-wrap.items-start.justify-between.gap-3
    div.space-y-1
      = render("shared/page_help", key: "reader", title: t("reader.title"))
    .flex.flex-wrap.gap-2
      = link_to t("reader.new_text"), new_reader_text_path, class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"

  nav.flex.flex-wrap.gap-1.text-sm
    = link_to t("reader.tabs.all"), reader_path,
      class: class_names("rounded-full px-3 py-1 font-medium", @kind.nil? ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")
    - ReadingText.kinds.keys.each do |kind|
      = link_to t("reader.tabs.#{kind}"), reader_path(kind:),
        class: class_names("rounded-full px-3 py-1 font-medium", @kind == kind ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")

  - if @texts.empty?
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("reader.empty")
  - else
    .grid.gap-2
      - @texts.each do |text|
        = link_to reader_text_path(text), class: "block rounded-xl border border-border bg-card px-4 py-3 transition-colors hover:border-primary/50 hover:bg-muted" do
          .flex.items-baseline.justify-between.gap-3
            span.truncate.font-semibold = text.title
            span.shrink-0.text-xs.text-muted-foreground = t("reader.tabs.#{text.kind}")
          - if text.author.present?
            .text-sm.text-muted-foreground = text.author
