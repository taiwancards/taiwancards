- content_for(:title, t("reader.new_text"))

.py-6.space-y-5
  header.space-y-1
    h1.text-2xl.font-bold.tracking-tight = t("reader.new_text")
    p.text-sm.text-muted-foreground = t("reader.new_hint")

  = form_with model: @text, url: reader_path, method: :post, scope: :reading_text, class: "space-y-4" do |form|
    .space-y-1
      = form.label :title, t("reader.title_label"), class: "text-sm font-medium"
      = form.text_field :title, class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"

    .flex.flex-wrap.gap-3
      .space-y-1
        = form.label :kind, t("reader.kind_label"), class: "text-sm font-medium"
        = form.select :kind, [[t("reader.tabs.article"), "article"], [t("reader.tabs.graded"), "graded"]], {}, class: "rounded-lg border border-border bg-card px-3 py-2 text-sm"
      .space-y-1
        = form.label :level_tag, t("reader.level_label"), class: "text-sm font-medium"
        = form.text_field :level_tag, placeholder: "TOCFL A2", class: "rounded-lg border border-border bg-card px-3 py-2 text-sm"

    .space-y-1
      = form.label :body, t("reader.body_label"), class: "text-sm font-medium"
      = form.text_area :body, rows: 12, lang: "zh-TW", placeholder: t("reader.body_placeholder"), class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-base leading-relaxed"

    = form.submit t("reader.save"), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90 cursor-pointer"
