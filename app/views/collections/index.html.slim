- content_for(:title, t("desks.title"))

.py-6.space-y-5
  header.flex.flex-wrap.items-start.justify-between.gap-3
    div.space-y-1
      = render("shared/page_help", key: "desks", title: t("desks.title"))
    = link_to t("desks.new"), new_desk_path, class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"

  - if @desks.empty?
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("desks.empty")
  - else
    .grid.gap-3 class="sm:grid-cols-2"
      - @desks.each do |desk|
        .rounded-xl.border.border-border.bg-card.p-4.space-y-3
          .flex.items-start.justify-between.gap-2
            div.min-w-0
              .truncate.font-semibold = desk.name
              .text-xs.text-muted-foreground = t("desks.items_count", count: desk.items_count)
            = button_to t("common.delete"), my_desk_path(desk), method: :delete, form: {data: {turbo_confirm: t("desks.delete_confirm")}}, class: "shrink-0 rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
          - facets = desk.study_facets
          - if facets.any?
            .flex.flex-wrap.gap-1
              - facets.each do |facet|
                span.rounded-full.bg-muted.px-2.text-xs.text-muted-foreground class="py-0.5" = t("memories.#{facet}")
          .flex.flex-wrap.gap-2.pt-1
            = link_to t("desks.study"), study_path(mode: "desk", collection_id: desk.id), class: "rounded-lg bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90"
            = link_to t("desks.open"), my_desk_path(desk), class: "rounded-lg border border-border px-3 py-1.5 text-sm font-medium hover:bg-muted"
