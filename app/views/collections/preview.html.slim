- content_for(:title, t("desks.preview"))

.py-6.space-y-5
  header.space-y-1
    h1.text-2xl.font-bold.tracking-tight = t("desks.preview")
    p.text-sm.text-muted-foreground = t("desks.preview_hint", count: @lexemes.size)

  .flex.flex-wrap.gap-2.text-sm
    span.rounded-lg.border.border-border.bg-card.px-3 class="py-1.5"
      = t("desks.stat_cards", count: @lexemes.size)
    - if @result.duplicates.positive?
      span.rounded-lg.border.border-border.px-3.text-muted-foreground class="py-1.5"
        = t("desks.stat_duplicates", count: @result.duplicates)
    - if @known_ids.any?
      span.rounded-lg.border.border-border.px-3.text-muted-foreground class="py-1.5"
        = t("desks.stat_known", count: @known_ids.size)
    - if @result.missing.any?
      span.rounded-lg.border.px-3 class="py-1.5 border-rose-400/60 text-rose-600 dark:text-rose-400"
        = t("desks.stat_missing", count: @result.missing.size)

  - if @result.missing.any?
    details.rounded-xl.border.border-border.p-3
      summary.cursor-pointer.text-sm.font-medium = t("desks.missing_title")
      p.mt-2.text-xs.text-muted-foreground = t("desks.missing_hint")
      .mt-2.flex.flex-wrap class="gap-1.5"
        - @result.missing.first(120).each do |token|
          span.rounded-md.border.border-dashed.border-border.px-2.py-1.text-sm lang="zh-TW" = token

  = form_with url: desks_path, method: :post, class: "space-y-4" do |form|
    div.space-y-1
      = form.label :name, t("desks.name_label"), class: "text-sm font-medium"
      = form.text_field :name, value: @name, placeholder: t("desks.name_placeholder"), class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"

    p.text-xs.text-muted-foreground = t("desks.order_hint")

    .divide-y.divide-border.overflow-hidden.rounded-xl.border.border-border
      - @lexemes.each do |lexeme|
        label.flex.cursor-pointer.items-baseline.gap-3.px-3.py-2 class="has-[:checked]:bg-primary/5"
          = check_box_tag "lexeme_ids[]", lexeme.id, true, class: "size-4 shrink-0 self-center rounded border-border"
          span.w-24.shrink-0.text-base.font-semibold lang="zh-TW" = lexeme.text
          - reading = lexeme.reading_set.first&.dig("zhuyin").presence || lexeme.reading_set.first&.dig("pinyin")
          span.w-28.shrink-0.text-xs.text-muted-foreground = reading
          span.min-w-0.flex-1.truncate.text-sm = lexeme.meaning
          - if @known_ids.include?(lexeme.id)
            span.shrink-0.text-xs.text-muted-foreground = t("words.progress.known")
          - elsif @started_ids.include?(lexeme.id)
            span.shrink-0.text-xs.text-muted-foreground = t("words.progress.learning")

    = render("shared/facet_picker", scope: "new")

    .flex.flex-wrap.gap-2.pt-1
      = form.submit t("desks.create"), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90 cursor-pointer"
      = link_to t("common.cancel"), new_desk_path, class: "rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted"

  = form_with url: desk_mark_known_path, method: :post, class: "space-y-2 rounded-xl border border-border p-3" do |form|
    - @lexemes.each do |lexeme|
      = hidden_field_tag "lexeme_ids[]", lexeme.id
    p.text-sm.font-medium = t("desks.known_title")
    p.text-xs.text-muted-foreground = t("desks.known_hint", count: @lexemes.size)
    = form.submit t("desks.known_action"), class: "rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted cursor-pointer"
