p.max-w-prose.text-sm.text-muted-foreground = t("imports.lede")

= form_with url: desk_import_preview_path, method: :post, multipart: true, data: {turbo: false}, class: "max-w-3xl space-y-5" do |form|
  fieldset.min-w-0.space-y-2
    legend.text-sm.font-medium = t("imports.source_label")
    .grid.gap-2 class="sm:grid-cols-3"
      - Collections::Import::Parser::SOURCES.each_with_index do |source, index|
        label.flex.cursor-pointer.flex-col.gap-1.rounded-xl.border.border-border.bg-card.p-3 class="has-[:checked]:border-primary has-[:checked]:bg-primary/5"
          span.flex.items-center.gap-2
            = radio_button_tag :source, source, index.zero?, class: "size-4", required: true
            span.font-semibold = t("imports.sources.#{source}.name")
          span.text-xs.leading-relaxed.text-muted-foreground = t("imports.sources.#{source}.steps")

  .space-y-1
    = form.label :file, t("imports.file_label"), class: "text-sm font-medium"
    = form.file_field :file, accept: ".txt,.tsv,.csv,.xml,text/plain,text/csv,text/xml", class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"
    p.text-xs.text-muted-foreground = t("imports.file_hint")

  .space-y-1
    = form.label :text, t("imports.text_label"), class: "text-sm font-medium"
    = form.text_area :text, rows: 6, lang: "zh-TW", placeholder: t("imports.text_placeholder"), class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"

  .space-y-1
    = form.label :name, t("imports.name_label"), class: "text-sm font-medium"
    = form.text_field :name, maxlength: 200, placeholder: t("desks.name_placeholder"), class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"

  = form.submit t("imports.check"), class: "min-h-11 cursor-pointer rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground hover:opacity-90 md:min-h-9"
