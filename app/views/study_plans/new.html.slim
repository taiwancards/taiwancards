- content_for(:title) { t("plan.new_title") }
- input = "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"

.mx-auto.max-w-md.py-6.space-y-5
  div
    h1.text-2xl.font-bold.tracking-tight = t("plan.new_title")
    p.mt-2.text-sm.text-muted-foreground = t("plan.new_intro")

  = form_with model: @plan, url: study_plan_path, method: :post, class: "space-y-4" do |form|
    - if @plan.errors.any?
      .rounded-lg.border.border-red-500.px-3.py-2.text-sm.text-red-600 class="bg-red-500/10"
        = @plan.errors.full_messages.to_sentence
    label.block.space-y-1
      span.text-sm.font-medium = t("plan.level")
      = form.select :target_level, StudyPlan::LEVELS.map { |level| [t("plan.levels.#{level}"), level] }, {}, class: input
    label.block.space-y-1
      span.text-sm.font-medium = t("plan.date")
      = form.date_field :target_date, class: input
    = form.submit t("plan.calculate"), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
