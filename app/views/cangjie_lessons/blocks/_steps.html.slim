section.space-y-3
  = cangjie_block_heading(block)
  ol.space-y-3
    - block["rows"].to_a.each_with_index do |row, index|
      li.space-y-2.rounded-2xl.border.border-border.bg-card.p-4
        .flex.flex-wrap.items-baseline.gap-x-2
          span.flex.size-6.shrink-0.items-center.justify-center.rounded-full.bg-brand.text-xs.font-semibold.text-white
            = index + 1
          span.text-sm.font-semibold lang="zh-TW" = cangjie_text(row["title"])
        p.text-sm.leading-relaxed.text-muted-foreground = cangjie_text(row["text"])
        - if row["chars"].to_a.any?
          .flex.flex-wrap.gap-2
            - row["chars"].each do |entry|
              = render("cangjie_lessons/chip", entry: entry, size: "text-xl")
