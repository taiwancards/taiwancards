- scope = local_assigns.fetch(:scope)
.flex.items-center.justify-center.gap-3
  span.font-mono.text-2xl.uppercase.tracking-widest data={"#{scope}-target" => "typed"} —
.space-y-1.select-none
  = render("shared/cangjie_keys", action: "#{scope}#press", key_class: "h-11 w-8 hover:bg-muted active:bg-primary/20 sm:h-12 sm:w-12")
  .flex.justify-center.gap-2.pt-1
    button.rounded-lg.border.border-border.px-4.py-2.text-sm.transition-colors[
      type="button" class="hover:bg-muted" data-action="#{scope}#erase" aria-label="Backspace" ] ⌫
    button.rounded-lg.border.border-border.px-4.py-2.text-sm.font-medium.transition-colors[
      type="button" class="hover:bg-muted" data-action="#{scope}#check"
      data={"#{scope}-target" => "check"} ]
      = t("cangjie_lessons.drills.check")
