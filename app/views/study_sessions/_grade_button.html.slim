- rating = local_assigns.fetch(:rating).to_s
- arrow = local_assigns.fetch(:arrow, false)
- palette = {"again" => ["text-red-500", "hover:border-red-400 hover:bg-red-500/10", "←"], "hard" => ["text-amber-500", "hover:border-amber-400 hover:bg-amber-500/10", "↓"], "good" => ["text-emerald-600", "hover:border-emerald-400 hover:bg-emerald-500/10", "→"], "easy" => ["text-violet-500", "hover:border-violet-400 hover:bg-violet-500/10", "↑"]}
- colour, hover, glyph = palette.fetch(rating)

button[ type="button" data-action="swipe-card#rate#{rating.camelize}"
  class="flex min-h-16 w-full flex-col items-center justify-center gap-0.5 rounded-2xl border border-border px-1 py-3 text-center text-sm font-semibold transition-colors #{colour} #{hover}" ]
  - if arrow
    span.text-base.leading-none.opacity-70 aria-hidden="true" = glyph
  span.leading-tight = t("study.grade.#{rating}")
