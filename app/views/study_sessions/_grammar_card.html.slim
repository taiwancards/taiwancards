- lesson = Huayu::GrammarLessons.find(lexeme.data["grammar_slug"])
- example = lesson&.examples&.first
- grade_button = "flex min-h-16 w-full items-center justify-center rounded-2xl border border-border px-2 py-3 text-center text-sm font-semibold transition-colors"

.select-none data-controller="swipe-card"
  = form_with url: study_review_path, method: :post, data: { swipe_card_target: "form", turbo_stream: true } do |form|
    = form.hidden_field :lexeme_id, value: lexeme.id
    = form.hidden_field :facet, value: facet
    = form.hidden_field :session_id, value: session_id
    = form.hidden_field :rating, value: "good", data: { swipe_card_target: "rating" }
    = form.hidden_field :elapsed_ms, value: "", data: { swipe_card_target: "elapsed" }

  .mx-auto class="max-w-3xl"
    .grid.items-center.gap-3 class="grid-cols-[1fr_1.7fr_1fr]"
      .w-full class="col-start-2 row-start-1"
        button[ type="button" data-action="swipe-card#rateEasy"
          class="#{grade_button} text-violet-500 hover:border-violet-400 hover:bg-violet-500/10" ]
          = t("study.grade.easy")

      .w-full class="col-start-1 row-start-2"
        button[ type="button" data-action="swipe-card#rateAgain"
          class="#{grade_button} text-red-500 hover:border-red-400 hover:bg-red-500/10" ]
          = t("study.grade.again")

      .relative class="col-start-2 row-start-2"
        .touch-none.cursor-pointer.rounded-3xl.border.border-border.bg-card.px-6.py-8.shadow-xl[
          data-swipe-card-target="card"
          data-action="pointerdown->swipe-card#start pointermove->swipe-card#move pointerup->swipe-card#end pointercancel->swipe-card#cancel click->swipe-card#flip" ]
          .flex.flex-col.items-center.justify-center.gap-3.text-center style="min-height: 15rem"
            .flex.items-center.gap-2.text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground
              = icon(:book, css: "size-4")
              = t("study.ask.grammar")
            .text-4xl.font-semibold lang="zh-TW" = lexeme.data["head"].presence || lexeme.text
            - if lesson
              .rounded-lg.bg-muted.px-3.py-1.text-sm.font-medium lang="zh-TW" = lesson.formula_for(I18n.locale)
            - if example
              .text-lg.leading-relaxed lang="zh-TW" = example.zh

            .hidden.w-full.space-y-3.text-left data-swipe-card-target="back"
              hr.border-border
              - if lesson
                .text-base.font-semibold.text-center = lesson.title(I18n.locale)
                p.text-sm.leading-relaxed.text-muted-foreground = lesson.body(I18n.locale)
              - if example&.translation(I18n.locale).present?
                .rounded-lg.border.border-border.px-3.py-2 class="bg-muted/30"
                  .text-base lang="zh-TW" = example.zh
                  .mt-1.text-sm.text-muted-foreground = example.translation(I18n.locale)
              - if lesson
                .pt-1.text-center
                  = link_to t("study.open_lesson"), grammar_lesson_path(lesson.slug), data: { no_swipe: "" },
                    class: "text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground"

      .w-full class="col-start-3 row-start-2"
        button[ type="button" data-action="swipe-card#rateGood"
          class="#{grade_button} text-emerald-600 hover:border-emerald-400 hover:bg-emerald-500/10" ]
          = t("study.grade.good")

      .w-full class="col-start-2 row-start-3"
        button[ type="button" data-action="swipe-card#rateHard"
          class="#{grade_button} text-amber-500 hover:border-amber-400 hover:bg-amber-500/10" ]
          = t("study.grade.hard")

  p.mx-auto.mt-3.max-w-3xl.text-center.text-xs.text-muted-foreground = t("study.hint")
