- kind = study_card_kind(lexeme:, facet:, memory: local_assigns[:memory])

- case kind
- when :writing
  = render("study_sessions/writing_card", lexeme:, facet:, session_id:, chars: Huayu::WritingTarget.new(lexeme).chars)
- when :tone_speech
  = render("study_sessions/tone_speech_card", lexeme:, facet:, session_id:, syllables: Huayu::PronunciationTarget.new(lexeme).syllables)
- when :tone_quiz
  = render("study_sessions/tone_quiz_card", lexeme:, facet:, session_id:, options: Huayu::ToneQuiz.new(lexeme).call)
- else
  = render("study_sessions/swipe_card", lexeme:, facet:, session_id:)
