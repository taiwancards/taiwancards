- runs = Huayu::SentenceSegments.runs_for([sentence])[sentence]
- clip = Huayu::ListeningClips.for_text(sentence.text)
.mx-auto.max-w-xl.space-y-1.rounded-lg.border.border-border.px-3.py-2.text-left class="bg-muted/30"
  .flex.items-center.gap-2
    .text-base.leading-relaxed
      = render("shared/sentence_runs", runs: runs, highlight: highlight)
    - if clip
      button.inline-flex.shrink-0.items-center.justify-center.rounded-full.p-1.text-muted-foreground[
        type="button" data-no-swipe="" data-controller="audio"
        data-audio-url-value=Huayu::ListeningClips.clip_url(clip.clip)
        data-action="click->audio#play" class="hover:bg-muted hover:text-foreground"
        aria-label=t("study.play") ]
        = icon(:speaker, css: "size-4")
  - if sentence.meaning.present?
    .text-xs.text-muted-foreground = sentence.meaning
