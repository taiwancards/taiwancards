- content_for(:title) { t("intro.page.title") }
- row = "flex items-center gap-3 rounded-xl border border-border bg-card px-3 py-2"
- control = "inline-flex size-11 shrink-0 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
- grades = {again: ["text-red-500", "border-red-500", "←"], hard: ["text-amber-500", "border-amber-500", "↓"], good: ["text-emerald-600", "border-emerald-600", "→"], easy: ["text-violet-500", "border-violet-500", "↑"]}

.py-6.space-y-8 class="pb-40 md:pb-24"
  header.space-y-2
    h1.text-2xl.font-bold.tracking-tight class="sm:text-3xl" = t("intro.page.title")
    p.max-w-2xl.leading-relaxed.text-muted-foreground = t("intro.page.lede")

  section.space-y-3
    h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("intro.page.loop.heading")
    p.max-w-2xl.text-sm.leading-relaxed.text-muted-foreground = t("intro.page.loop.lede")

    ol.grid.gap-2 class="sm:grid-cols-2 lg:grid-cols-4"
      - %w[queue card facets schedule].each_with_index do |key, index|
        li.flex.flex-col.rounded-xl.border.border-border.bg-card.px-3.py-3
          span.inline-flex.size-6.shrink-0.items-center.justify-center.rounded-full.bg-muted.text-xs.font-bold.text-muted-foreground
            = index + 1
          span.mt-2.text-sm.font-semibold = t("intro.page.loop.steps.#{key}.title")
          span.mt-1.text-sm.leading-snug.text-muted-foreground = t("intro.page.loop.steps.#{key}.body")

    .rounded-xl.border.border-border.p-3.space-y-2 class="sm:p-4 bg-muted/30"
      p.text-sm.font-medium = t("intro.page.loop.grades")
      ul.grid.gap-2 class="sm:grid-cols-2"
        - grades.each do |key, (text_colour, border_colour, arrow)|
          li.flex.items-start.gap-2.5
            span.inline-flex.size-7.shrink-0.items-center.justify-center.rounded-lg.border-2.text-sm.font-bold class="#{border_colour} #{text_colour}"
              = arrow
            p.min-w-0.text-xs.leading-relaxed
              span.font-semibold class=text_colour = t("study.grade.#{key}")
              span.text-muted-foreground
                = " — "
                = t("study.grade_help.#{key}")
      p.text-xs.leading-relaxed.text-muted-foreground = t("intro.page.loop.honest")

  section.space-y-3
    h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("intro.page.inside.heading")
    p.max-w-2xl.text-sm.leading-relaxed.text-muted-foreground = t("intro.page.inside.lede")
    .grid.gap-2 class="sm:grid-cols-2 lg:grid-cols-4"
      - @blocks.each do |block|
        = link_to Locales.swap(block.path, I18n.locale), class: "flex flex-col rounded-xl border border-border bg-card px-3 py-2.5 transition-colors hover:border-primary/60 hover:bg-muted" do
          span.text-sm.font-semibold = t("intro.page.blocks.#{block.id}.title")
          span.mt-1.flex-1.text-sm.leading-snug.text-muted-foreground = t("intro.page.blocks.#{block.id}.body")
          - if block.figures.any?
            span.mt-2.flex.flex-wrap class="gap-1"
              - block.figures.each do |name, value|
                span.rounded-full.bg-muted.text-xs.text-muted-foreground class="px-2 py-0.5 tabular-nums"
                  = t("intro.page.figures.#{name}", value: number_with_delimiter(value))

  section.space-y-3
    h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("intro.page.prefs.heading")
    p.max-w-2xl.text-sm.leading-relaxed.text-muted-foreground = t("intro.page.prefs.lede")
    .grid.gap-2 class="lg:grid-cols-2"
      - %w[readings font china detail].each do |name|
        div class=row
          = render "shared/prefs/#{name}", class: control
          .min-w-0
            .text-sm.font-semibold = t("intro.page.prefs.#{name}.title")
            p.text-sm.leading-snug.text-muted-foreground = t("intro.page.prefs.#{name}.body")
    p.text-sm.leading-relaxed.text-muted-foreground = t("intro.page.prefs.where")

  p.text-sm.leading-relaxed.text-muted-foreground
    = t("intro.page.guide.body")
    = " "
    = link_to t("intro.page.guide.cta"), guide_path, class: "font-medium text-brand hover:underline"

  - if @running
    .sticky.z-30.flex.flex-wrap.items-center.gap-3.rounded-2xl.border.border-border.bg-background.p-4.shadow-lg class="bottom-20 md:bottom-4"
      p.min-w-0.flex-1.text-sm.text-muted-foreground
        = @level_chosen ? t("intro.page.finish.body_known") : t("intro.page.finish.body")
      = button_to t("intro.page.finish.cta"), intro_next_path, method: :post, form_class: "contents",
        class: "inline-flex min-h-11 items-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground hover:opacity-90"
