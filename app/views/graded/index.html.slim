- content_for(:title, t("graded.title"))
.py-6.space-y-6
  header.space-y-2
    h1.text-2xl.font-bold.tracking-tight = t("graded.title")
    p.text-sm.leading-relaxed.text-muted-foreground = t("graded.lede")

  - if (upcoming = @shelf&.next_text)
    = link_to graded_text_path(tier: upcoming.tier, id: upcoming.id),
      class: "flex min-h-11 items-center justify-between gap-3 rounded-xl border border-primary/40 bg-primary/5 p-4 transition-colors hover:bg-primary/10" do
      span.min-w-0
        span.block.text-xs.font-medium.uppercase.tracking-wide.text-primary = t("graded.continue")
        span.mt-1.block.truncate.text-base.font-semibold
          span lang="zh-TW" = upcoming.zh
          span.font-normal.text-muted-foreground = " · #{upcoming.title(I18n.locale)}"
        span.mt-0.5.block.text-xs.text-muted-foreground = t("graded.tiers.#{upcoming.tier}")
      span.shrink-0.text-lg.text-primary aria-hidden="true" →

  .rounded-xl.border.border-border.px-4.py-3.text-xs.leading-relaxed.text-muted-foreground class="bg-muted/30"
    = t("graded.method")

  - if @tiers.empty?
    p.text-sm.text-muted-foreground = t("graded.empty")
  - else
    .grid.gap-3 class="sm:grid-cols-2 xl:grid-cols-3"
      - @tiers.each do |tier|
        - texts = Graded::Library.texts(tier.id)
        - progress = @shelf&.progress(tier.id)
        - suggested = @shelf&.tier&.id == tier.id
        = link_to graded_tier_path(tier: tier.id),
          class: "min-w-0 rounded-xl border bg-card p-4 transition-colors hover:bg-muted #{suggested ? "border-primary/60" : "border-border"}" do
          .flex.items-baseline.justify-between.gap-2
            .text-sm.font-semibold = t("graded.tiers.#{tier.id}")
            - if suggested
              span.shrink-0.rounded-full.bg-primary/10.px-2.py-0.5.text-2xs.font-medium.text-primary = t("graded.your_level")
          p.mt-1.text-xs.text-muted-foreground.tabular-nums
            - if progress&.started?
              = t("graded.tier_progress", read: progress.read, total: progress.total)
            - else
              = t("graded.tier_hint", count: texts.size)
          - if progress&.started?
            .mt-2.h-1.overflow-hidden.rounded-full.bg-muted
              .h-full.rounded-full.bg-emerald-500 style="width: #{(100.0 * progress.read / progress.total).round}%"
          ul.mt-2.space-y-1
            - texts.each do |text|
              li.flex.items-start.gap-1.text-sm.leading-snug
                - if @shelf&.read?(text)
                  = icon(:check, css: "mt-0.5 size-3.5 shrink-0 text-emerald-600", stroke: 2.2)
                span.min-w-0
                  span.font-medium lang="zh-TW" = text.zh
                  span.text-muted-foreground = " (#{text.title(I18n.locale)})"
