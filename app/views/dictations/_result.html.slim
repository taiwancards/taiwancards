- result = local_assigns.fetch(:result)
- row = local_assigns.fetch(:row)
- sentence = local_assigns[:sentence]
- tone = result.percent >= 90 ? "text-emerald-600" : (result.percent >= 60 ? "text-amber-600" : "text-red-600")

.space-y-4 data-dictation-target="score" data-percent=result.percent
  .flex.flex-wrap.items-baseline.justify-between.gap-x-4.gap-y-1
    span.text-3xl.font-bold.tabular-nums class=tone = "#{result.percent}%"
    ul.flex.flex-wrap.gap-x-3.gap-y-1.text-xs.text-muted-foreground
      - DictationHelper::MARKS.each do |mark|
        - count = result.counts[mark].to_i
        - next if count.zero?
        li.inline-flex.items-center.gap-1
          span.size-2.rounded-full class=dictation_dot(mark)
          = "#{t("dictation.marks.#{mark || :missed}")}: #{count}"
      - if result.extra.positive?
        li = "#{t("dictation.extra")}: #{result.extra}"

  .flex.flex-wrap.gap-x-1.gap-y-3
    - result.cells.each do |cell|
      .flex.flex-col.items-center.gap-1 title=t("dictation.marks.#{cell.mark || :missed}")
        span.rounded-md.px-1.py-0.5.text-2xl class=dictation_cell(cell.mark)
          - if cell.zhuyin
            = zhuyin_ruby(cell.char, cell.zhuyin, context: :text)
          - else
            span lang="zh-TW" = cell.char
        span.min-h-4.text-2xs.leading-none.text-muted-foreground lang="zh-TW" = cell.typed unless cell.exact?

  - if result.answer.present?
    p.text-sm
      span.text-muted-foreground = "#{t("dictation.you_wrote")} "
      span lang="zh-TW" = result.answer
  p.text-sm = row.translation(I18n.locale)
  - if sentence
    = link_to t("dictation.open_sentence"), sentence_path(sentence), class: "inline-flex min-h-11 items-center text-xs font-medium text-primary hover:underline md:min-h-0"
