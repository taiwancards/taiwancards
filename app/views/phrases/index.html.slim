- content_for(:title) { t("phrases.title") }
.py-6.space-y-6
  div
    = render("shared/page_help", key: "phrases", title: t("phrases.title"))

  - if @scenes.empty?
    p.rounded-xl.border.border-border.p-4.text-sm.text-muted-foreground = t("phrases.empty")
  - else
    nav.flex.flex-wrap.gap-2
      - @scenes.each do |scene|
        = link_to phrases_path(scene: scene.id, role: @role), class: phrase_chip_class(scene.id == @scene&.id) do
          span lang="zh-TW" = scene.zh
          span.ml-1.opacity-70 = @counts[scene.id]

    .flex.flex-wrap.items-center.gap-2
      = link_to t("phrases.roles.all"), phrases_path(scene: @scene&.id), class: phrase_chip_class(@role.nil?)
      - PhrasesController::ROLES.each do |role|
        = link_to t("phrases.roles.#{role}"), phrases_path(scene: @scene&.id, role:), class: phrase_chip_class(@role == role)

    - if @scene
      p.max-w-2xl.text-sm.text-muted-foreground = @scene.name(I18n.locale)

    - if @dialogue
      = link_to phrase_dialogue_path(scene: @scene.id),
        class: "flex min-h-11 items-center justify-between gap-3 rounded-xl border border-primary/40 bg-primary/5 p-4 transition-colors hover:bg-primary/10" do
        span.min-w-0
          span.block.text-sm.font-semibold = t("phrases.dialogue.open")
          span.mt-0.5.block.text-xs.leading-relaxed.text-muted-foreground = t("phrases.dialogue.open_hint")
        span.shrink-0.text-lg.text-primary aria-hidden="true" →

    .space-y-3
      - @patterns.each do |pattern|
        = render("phrases/pattern", pattern:, entries: @lexicon.for(pattern))

    - @slots.each do |slot|
      = render("phrases/slot", slot:)
