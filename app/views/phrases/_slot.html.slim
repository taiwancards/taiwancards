- slot = local_assigns.fetch(:slot)

section.rounded-2xl.border.border-dashed.border-border.p-4.space-y-2
  h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = slot.name(I18n.locale)
  .flex.flex-wrap.gap-2
    - slot.options.each do |option|
      .rounded-lg.border.border-border.px-2.py-1
        span.text-base.font-medium lang="zh-TW" = option.text
        span.pinyin.ml-1.text-2xs.text-muted-foreground = option.pinyin
        span.ml-2.text-xs.text-muted-foreground = option.name(I18n.locale)
