- font = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif"
doctype html
html lang=I18n.locale
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    title = @subject
  body style="margin:0;padding:24px 12px;background:#f4f4f2;font-family:#{font};font-size:16px;line-height:1.6;color:#111111;"
    div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e7e5e4;border-radius:14px;padding:28px;"
      p style="margin:0 0 12px;font-size:20px;font-weight:700;line-height:1.3;" = @subject
      p style="margin:0 0 14px;" = t("#{@scope}.happened", at: @at)
      p style="margin:0 0 2px;font-weight:700;" = t("scan.alerts.learners_heading")
      p style="margin:0 0 14px;" = t("#{@scope}.learners")
      p style="margin:0 0 2px;font-weight:700;" = t("scan.alerts.action_heading")
      p style="margin:0 0 20px;" = t("#{@scope}.action")
      a href=@admin_url style="display:inline-block;padding:12px 20px;border-radius:10px;background:#111111;color:#ffffff;font-weight:600;text-decoration:none;" = t("scan.alerts.open_admin")
