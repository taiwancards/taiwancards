- lexeme = local_assigns.fetch(:lexeme)
- note = Locales.pick(lexeme.data["note"])

= render(layout: "shared/word_tile", locals: {lexeme:, tier: lexeme.data.dig("game", "tier"), meaning_class: "text-[12px]"}) do
  - if note.present?
    p.leading-snug.text-muted-foreground class="text-[11px]" = note
