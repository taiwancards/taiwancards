- content_for(:title, t("auth.login_title"))

.mx-auto.mt-16.max-w-sm.space-y-6
  .text-center
    .text-2xl.font-bold.tracking-tight
      span Taiwan
      span.text-muted-foreground Cards
    p.mt-1.text-sm.text-muted-foreground = t("auth.login_subtitle")

  .space-y-4.rounded-2xl.border.border-border.bg-card.p-6
    = render "shared/google_button"
    p.text-center.text-xs.leading-relaxed.text-muted-foreground = t("auth.google_only_note")

  p.text-center.text-xs.leading-relaxed.text-muted-foreground = t("auth.login_pitch")
