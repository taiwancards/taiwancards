- content_for(:title, t("nav.more"))
- item_classes = "flex min-h-11 items-center gap-2.5 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium transition-colors hover:bg-muted"
- settings_entries, group_entries = language_nav.partition { |entry| entry[:key] == :settings }

.py-6.space-y-5
  h1.text-2xl.font-bold.tracking-tight = t("nav.more")

  .flex.min-h-12.items-center.justify-center.rounded-xl.border.border-border.bg-card.px-3.py-2
    = render "shared/script_prefs", inside_app: authenticated?, readings: true

  - settings_entries.each do |entry|
    section.space-y-2 data-tour=entry[:tour]
      h2.text-xs.font-semibold.uppercase.tracking-wide.text-muted-foreground = entry[:label]
      .grid class="grid-cols-2 gap-1.5 sm:grid-cols-3"
        - entry[:items].each do |key, label, path|
          = link_to path, data: {tour: nav_item_tour(path)}, class: item_classes do
            = icon(key, css: "size-4 shrink-0 text-muted-foreground")
            span.truncate = label
        - if current_user&.admin?
          = link_to admin_users_path, class: item_classes do
            = icon(:settings, css: "size-4 shrink-0 text-muted-foreground")
            span.truncate = t("admin.title")

  - group_entries.each do |entry|
    section.space-y-2 data-tour=entry[:tour]
      h2.text-xs.font-semibold.uppercase.tracking-wide.text-muted-foreground = entry[:label]
      .grid class="grid-cols-2 gap-1.5 sm:grid-cols-3"
        - entry[:items].each do |key, label, path|
          = link_to path, data: {tour: nav_item_tour(path)}, class: item_classes do
            = icon(key, css: "size-4 shrink-0 text-muted-foreground")
            span.truncate = label
