- content_for(:title) { t("terms.title") }
- link_class = "text-foreground hover:underline"

.py-6.space-y-6
  div
    h1.text-2xl.font-bold.tracking-tight = t("terms.title")
    p.text-muted-foreground = t("terms.effective")

  - %w[service account use yours ours availability suspension liability changes].each do |key|
    = legal_section("terms.#{key}")

  section.space-y-2
    h2.text-lg.font-semibold = t("terms.contact.heading")
    p.text-sm.leading-6.text-muted-foreground
      = t("terms.contact.body")
      =< mail_to Site::SUPPORT_EMAIL, Site::SUPPORT_EMAIL, class: link_class

  section.space-y-2
    h2.text-lg.font-semibold = t("terms.related.heading")
    p.text-sm.leading-6
      = link_to t("footer.privacy"), privacy_path, class: link_class
      |  ·
      =< link_to t("footer.licenses"), licenses_path, class: link_class
