- content_for(:title) { t("privacy.title") }
- link_class = "text-foreground hover:underline"
- link_opts = {rel: "noopener", target: "_blank", class: link_class}

.py-6.space-y-6
  div
    h1.text-2xl.font-bold.tracking-tight = t("privacy.title")
    p.text-muted-foreground = t("privacy.effective")

  - %w[purpose stored never cookies].each do |key|
    = legal_section("privacy.#{key}")

  - if Donate.offered?
    = legal_section("privacy.donation")

  section#google-data.space-y-3 class="scroll-mt-16"
    h2.text-lg.font-semibold = t("privacy_google.heading")
    p.text-sm.leading-6.text-muted-foreground = t("privacy_google.body")
    ul.space-y-2
      - %w[signin drive limits].each do |key|
        li.flex.items-start.gap-2.text-sm.leading-6
          span.mt-2.size-1 class="shrink-0 rounded-full bg-foreground"
          span = t("privacy_google.#{key}")
    p.text-sm.leading-6.text-muted-foreground
      = t("privacy_google.policy_before")
      =< link_to t("privacy_google.policy_name"), "https://developers.google.com/terms/api-services-user-data-policy", link_opts
      = t("privacy_google.policy_after")

  - %w[where retention choices children changes].each do |key|
    = legal_section("privacy.#{key}")

  section.space-y-2
    h2.text-lg.font-semibold = t("privacy.contact.heading")
    p.text-sm.leading-6.text-muted-foreground
      = t("privacy.contact.body")
      =< mail_to Site::SUPPORT_EMAIL, Site::SUPPORT_EMAIL, class: link_class

  section.space-y-2
    h2.text-lg.font-semibold = t("privacy.related.heading")
    p.text-sm.leading-6
      = link_to t("footer.terms"), terms_path, class: link_class
      |  ·
      =< link_to t("footer.licenses"), licenses_path, class: link_class
