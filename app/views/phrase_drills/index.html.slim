- content_for(:title, t("phrase_drills.title"))
- chip = "relative inline-flex shrink-0 cursor-pointer items-center whitespace-nowrap rounded-md border border-border px-2 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-muted has-checked:border-primary has-checked:bg-primary/10 has-checked:font-medium has-checked:text-foreground"
- picker = "rounded-lg border border-border bg-card px-2 py-1 text-xs disabled:opacity-40"

.py-6.space-y-5.reading-hints.hints-zhuyin data-controller="reading-hints"
  header.flex.flex-wrap.items-start.justify-between.gap-3
    .space-y-1
      h1.text-2xl.font-bold.tracking-tight = t("phrase_drills.title")
      p.text-sm.text-muted-foreground = t("phrase_drills.subtitle", count: @total)
    = render("grammar/hints")

  = form_with url: textbook_phrases_path, method: :get, class: "space-y-2 rounded-xl border border-border p-3",
    data: {controller: "filters", action: "change->filters#submit"} do
    .flex.items-center.gap-2
      .w-24.shrink-0.text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("phrase_drills.level")
      .flex.flex-1.gap-1.overflow-x-auto class="py-0.5"
        - PhraseDrillsController::LEVELS.each do |level|
          label class=chip
            = radio_button_tag(:level, level, @level == level, class: "sr-only")
            = t("phrase_drills.level_n", n: level)
        label class=chip
          = radio_button_tag(:level, "", @level.nil?, class: "sr-only")
          = t("phrase_drills.any_level")
    .flex.flex-wrap.items-center.gap-2
      .w-24.shrink-0.text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("phrase_drills.curriculum")
      = select_tag :scheme, options_for_select([[t("phrase_drills.any_grade"), ""], %w[TOCFL tocfl], %w[TBCL tbcl]], @scheme),
        class: picker, data: {filters_target: "scheme", action: "change->filters#changeScheme"}
      = select_tag :grade, options_for_select([[t("phrase_drills.any_grade"), ""]] + grade_options, @grade),
        class: picker, data: {filters_target: "grade"}
      - PhraseDrillsController::BOOKS.each do |book|
        label class=chip
          = radio_button_tag(:book, book, @book == book, class: "sr-only")
          = book
      label class=chip
        = radio_button_tag(:book, "", @book.nil?, class: "sr-only")
        = t("phrase_drills.any_book")
    .flex.flex-wrap.items-center.gap-2
      = search_field_tag :q, @q, placeholder: t("phrase_drills.search_placeholder"),
        class: "min-w-40 flex-1 rounded-lg border border-border bg-card px-3 py-2 text-sm"
      = submit_tag t("sentences.apply"), class: "cursor-pointer rounded-lg bg-primary px-3 py-1 text-xs font-medium text-primary-foreground hover:opacity-90"
      - if @q.present? || @level || @scheme || @book
        = link_to t("sentences.reset"), textbook_phrases_path, class: "text-xs text-muted-foreground underline underline-offset-2"

  - if @phrases.empty?
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("phrase_drills.empty")
  - else
    .divide-y.divide-border.rounded-xl.border.border-border[
      data-controller="analyzer" data-analyzer-activate-url-value=reader_activate_path
      data-analyzer-added-value=t("reader.added") data-analyzer-add-value=t("reader.add") ]
      - @phrases.zip(@tokens).each do |phrase, tokens|
        .space-y-1.px-4.py-3 class="hover:bg-muted/50"
          .text-xl.leading-loose lang="zh-TW"
            - tokens.each do |token|
              - if token.kind == :literal
                span style="white-space: pre-wrap" = token.text
              - else
                span.cursor-pointer.rounded.transition-colors[class="hover:bg-primary/10"
                  data-analyzer-target="word" data-token=analyze_token_payload(token).to_json
                  data-action="mouseenter->analyzer#open click->analyzer#open" ]
                  - if (zhuyin = drill_token_zhuyin(token))
                    = zhuyin_ruby(token.text, zhuyin, context: :text)
                  - else
                    = token.text
          p.py-line.pinyin-locked.text-sm.text-muted-foreground = drill_pinyin(tokens)
          .sentence-body
            .sentence-tags
              span.sentence-tag title=t("phrase_drills.book_hint") = drill_book(phrase)
              - PhraseDrillsController::SCHEMES.each do |scheme|
                - next unless (grade = drill_grade(phrase, scheme))
                span.sentence-tag title=t("phrase_drills.grade_hint", scheme: scheme.upcase, level: grade.delete("*"))
                  = "#{scheme.upcase} #{grade}"
              span title=t("phrase_drills.level_hint", score: phrase.data["difficulty"])
                = score_badge(phrase)
            p.text-sm = phrase.meaning

      .fixed.z-50.hidden.w-72.rounded-xl.border.border-border.bg-card.p-3.text-base.shadow-xl[
        data-analyzer-target="popover" class="max-w-[85vw]" ]

    p.text-xs.text-muted-foreground = t("phrase_drills.approximate")
    = render("shared/pager", page: @page, pages: @pages, path: ->(n) { textbook_phrases_path(level: @level, scheme: @scheme, grade: @grade, book: @book, q: @q.presence, page: n) })
