doctype html
html lang=I18n.locale.to_s
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="csrf-token" content=form_authenticity_token
    title Markup
    css:
      :root { color-scheme: light dark; --line: #8884; }
      * { box-sizing: border-box; }
      body { margin: 0; padding: 2rem 1rem 4rem; font: 16px/1.5 -apple-system, "Segoe UI", system-ui, sans-serif; }
      main { max-width: 46rem; margin: 0 auto; }
      .bar { display: flex; gap: .75rem; align-items: baseline; font-size: .85rem; opacity: .7; margin-bottom: 1.25rem; flex-wrap: wrap; }
      .bar a { color: inherit; }
      .zh { font-size: 2rem; line-height: 1.4; margin: 0 0 1rem; }
      .words { list-style: none; padding: 0; margin: 0 0 1.5rem; font-size: .9rem; }
      .words li { padding: .2rem 0; border-bottom: 1px solid var(--line); display: flex; gap: .75rem; }
      .words b { font-weight: 600; min-width: 5rem; font-size: 1.05rem; }
      .words span { opacity: .75; }
      label { display: block; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; opacity: .6; margin: 1rem 0 .25rem; }
      textarea { width: 100%; min-height: 4.5rem; padding: .6rem .7rem; font: inherit; border: 1px solid var(--line); border-radius: .4rem; background: transparent; color: inherit; resize: vertical; }
      .actions { display: flex; gap: .75rem; margin-top: 1.5rem; align-items: center; flex-wrap: wrap; }
      button, .btn { font: inherit; padding: .5rem 1.1rem; border-radius: .4rem; border: 1px solid var(--line); background: transparent; color: inherit; cursor: pointer; text-decoration: none; }
      button[type="submit"] { border-color: currentColor; font-weight: 600; }
      .danger { margin-left: auto; opacity: .55; }
      .hint { font-size: .75rem; opacity: .5; margin-top: 1.5rem; }
  body
    main = yield
