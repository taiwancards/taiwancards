- content_for(:title, t("handwriting.title"))

.py-6.space-y-6
  header.space-y-1
    = render("shared/page_help", key: "handwriting", title: t("handwriting.title"))

  - unless @available
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("handwriting.data_missing")

  - if @available
    .grid.gap-6.md:grid-cols-2[
      data-controller="handwriting"
      data-handwriting-url-value=SharedAssets.url_for("json", HandwritingController::DATA)
      data-handwriting-base-value="/characters" ]
      .space-y-3
        .relative.mx-auto.w-full.max-w-sm
          canvas.aspect-square.w-full.touch-none.rounded-2xl.border.border-border.bg-card[
            data-handwriting-target="canvas" ]
        .flex.items-center.justify-between.gap-2
          .text-sm.text-muted-foreground[
            data-handwriting-target="status" data-loading=t("handwriting.loading") data-failed=t("handwriting.failed") ]
          .flex.gap-2
            button.rounded-lg.border.border-border.px-4.py-2.text-sm.font-medium[
              type="button" data-action="handwriting#undo" class="hover:bg-muted" ]
              = t("handwriting.undo")
            button.rounded-lg.border.border-border.px-4.py-2.text-sm.font-medium[
              type="button" data-action="handwriting#clear" class="hover:bg-muted" ]
              = t("handwriting.clear")

      .space-y-3
        h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("handwriting.matches")
        p.text-xs.text-muted-foreground = t("handwriting.hint")
        .flex.flex-wrap.gap-2 data-handwriting-target="results"
