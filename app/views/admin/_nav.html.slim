- links = [[t("admin.title"), admin_users_path, "admin/users"], [t("admin.activity"), admin_activity_path, "admin/activity"], [t("admin.funnel.title"), admin_funnel_path, "admin/funnel"], [t("admin.reminders.title"), admin_reminders_path, "admin/reminders"], [t("admin.mail.title"), admin_mail_path, "admin/mail"], [t("admin.traffic.title"), admin_traffic_path, "admin/traffic"], [t("scan.admin.title"), admin_scans_path, "admin/scans"], [t("admin.sources.title"), admin_content_sources_path, "admin/content_sources"], [t("newsletters.admin.title"), admin_newsletters_path, "admin/newsletters"], [t("pron.judge.title"), pronunciation_judgments_path, "pronunciation_judgments"]]

- scans_issue = scan_health.headline

nav.flex.flex-wrap.items-center.gap-x-4.gap-y-1
  - links.each do |label, path, key|
    - here = controller_path == key
    = link_to path, class: "text-sm #{here ? "font-semibold" : "text-muted-foreground hover:text-foreground"}" do
      = label
      - if key == "admin/scans" && scans_issue
        span.ms-1.inline-block.size-2.rounded-full.bg-destructive.align-middle role="img" aria-label=t("scan.admin.health.marker") title=t("scan.admin.health.#{scans_issue}")

- if scans_issue
  p.text-sm.font-medium.text-destructive
    = link_to t("scan.admin.health.#{scans_issue}"), admin_scans_path(anchor: "scan-key"), class: "underline underline-offset-2"
