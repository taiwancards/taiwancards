- links = [[t("admin.title"), admin_users_path, "admin/users"], [t("admin.activity"), admin_activity_path, "admin/activity"], [t("admin.sources.title"), admin_content_sources_path, "admin/content_sources"], [t("newsletters.admin.title"), admin_newsletters_path, "admin/newsletters"], [t("pron.judge.title"), pronunciation_judgements_path, "pronunciation_judgements"]]

nav.flex.flex-wrap.items-center.gap-x-4.gap-y-1
  - links.each do |label, path, key|
    - here = controller_path == key
    = link_to label, path, class: "text-sm #{here ? "font-semibold" : "text-muted-foreground hover:text-foreground"}"
