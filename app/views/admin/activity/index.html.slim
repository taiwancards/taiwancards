- content_for(:title) { t("admin.activity") }
- base = -> (extra) { admin_activity_path({days: @days, user_id: @user&.id}.compact.merge(extra)) }

.py-6.space-y-6
  header.space-y-2
    = render "admin/nav"
    h1.text-2xl.font-bold.tracking-tight = t("admin.activity")
    p.text-sm.text-muted-foreground
      = t("admin.activity_intro", days: @days, count: number_with_delimiter(@digest.total), retention: ActivityEvent::RETENTION.in_days.to_i)

  .flex.flex-wrap.items-center.gap-x-3.gap-y-1
    span.text-xs.uppercase.tracking-wide.text-muted-foreground = t("admin.window")
    - Admin::ActivityController::WINDOWS.each do |days|
      = link_to t("admin.days", count: days), admin_activity_path(days: days, user_id: @user&.id), class: "text-sm #{@days == days ? "font-semibold" : "text-muted-foreground hover:text-foreground"}"
    - if @user
      = link_to t("admin.clear_filter", email: @user.display_name), admin_activity_path(days: @days), class: "text-sm text-muted-foreground underline underline-offset-2 hover:text-foreground"

  .grid.gap-4 class="sm:grid-cols-2"
    section.rounded-xl.border.border-border.p-4.space-y-2
      h2.text-sm.font-semibold = t("admin.by_user")
      - if @digest.per_user.empty?
        p.text-sm.text-muted-foreground = t("admin.activity_empty")
      - else
        - top = @digest.per_user.values.max
        ul.space-y-1
          - @digest.per_user.each do |email, count|
            li.space-y-1
              .flex.items-baseline.justify-between.gap-2.text-sm
                span.truncate = email
                span.shrink-0.tabular-nums.text-muted-foreground = count
              .h-1.w-full.overflow-hidden.rounded-full.bg-muted
                .h-full.rounded-full.bg-primary style="width: #{(count * 100.0 / top).round}%"

    section.rounded-xl.border.border-border.p-4.space-y-2
      h2.text-sm.font-semibold = t("admin.by_section")
      - if @digest.per_section.empty?
        p.text-sm.text-muted-foreground = t("admin.activity_empty")
      - else
        - top = @digest.per_section.values.max
        ul.space-y-1
          - @digest.per_section.each do |controller, count|
            li.space-y-1
              .flex.items-baseline.justify-between.gap-2.text-sm
                span.truncate = controller.split("/").last.humanize
                span.shrink-0.tabular-nums.text-muted-foreground = count
              .h-1.w-full.overflow-hidden.rounded-full.bg-muted
                .h-full.rounded-full.bg-primary style="width: #{(count * 100.0 / top).round}%"

  - if @digest.per_day.any?
    section.rounded-xl.border.border-border.p-4.space-y-2
      h2.text-sm.font-semibold = t("admin.by_day")
      .flex.items-end.gap-1 style="height: 5rem"
        - peak = @digest.per_day.values.max
        - @digest.per_day.each do |day, count|
          .flex-1.rounded-t.bg-primary title="#{day}: #{count}" style="height: #{[(count * 100.0 / peak).round, 4].max}%"
      .flex.justify-between.text-xs.text-muted-foreground
        span = @digest.per_day.keys.first
        span = @digest.per_day.keys.last

  section.space-y-2
    h2.text-sm.font-semibold = t("admin.recent")
    - if @events.empty?
      p.rounded-lg.border.border-dashed.border-border.px-4.py-8.text-center.text-sm.text-muted-foreground
        = t("admin.activity_empty")
    - else
      .divide-y.divide-border.rounded-xl.border.border-border
        - @events.each do |event|
          .flex.flex-wrap.items-baseline.gap-x-3.gap-y-1.px-3.py-2.text-sm
            span.shrink-0.text-xs.tabular-nums.text-muted-foreground = l(event.created_at, format: :short)
            - if event.user
              = link_to event.user.display_name, admin_user_path(event.user), class: "min-w-0 flex-1 truncate font-medium underline underline-offset-2"
            - else
              span.min-w-0.flex-1.truncate.font-medium = "—"
            span.shrink-0.rounded.bg-muted.px-1.text-xs.text-muted-foreground = event.verb
            span.min-w-0.truncate.text-xs.text-muted-foreground class="basis-full sm:basis-auto" = event.path
      = render("shared/pager", page: @page, pages: @pages, path: -> (n) { base.call(page: n) })
