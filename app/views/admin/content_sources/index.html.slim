- content_for(:title) { t("admin.sources.title") }

.py-6.space-y-4
  div
    = render "admin/nav"
    h1.mt-2.text-2xl.font-bold.tracking-tight = t("admin.sources.title")
    p.mt-1.text-sm.text-muted-foreground = t("admin.sources.intro")

  - measurement = @sources.select(&:measurement_only?)
  - if measurement.any?
    .rounded-xl.border.border-border.p-3
      p.text-sm.text-muted-foreground = t("admin.sources.measurement_hint", count: measurement.length)

  .divide-y.divide-border.rounded-xl.border.border-border
    - @sources.each do |source|
      .space-y-2.p-3
        .flex.flex-wrap.items-start.gap-x-4.gap-y-2
          .min-w-0 class="flex-1 basis-64"
            .flex.flex-wrap.items-center.gap-2
              span.font-medium = source.name
              - if source.register.present?
                span.rounded.bg-muted.text-xs.text-muted-foreground class="px-1.5 py-0.5" = t("admin.sources.registers.#{source.register}")
              - if source.hidden_from_everyone?
                span.rounded.bg-red-500 class="px-1.5 py-0.5 text-xs text-white" = t("admin.sources.off")

            .mt-1.flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-xs.text-muted-foreground
              - if source.url.present?
                = link_to source.name_en.presence || source.url, source.url, class: "underline underline-offset-2", target: "_blank", rel: "noopener"
              - if source.license_name.present?
                span
                  = source.license_name
                  - if source.license_commercial?
                    span.ml-1.text-emerald-600 = t("admin.sources.commercial_ok")
                  - else
                    span.ml-1.text-amber-600 = t("admin.sources.commercial_no")

            .mt-1.flex.flex-wrap.gap-x-3.gap-y-1.text-xs.text-muted-foreground
              - {sentences: source.sentences_count, collocations: source.collocations_count, audio: source.audio_count, translations: source.translations_count}.each do |label, count|
                - next if count.zero?
                span = "#{t("admin.sources.counts.#{label}")}: #{number_with_delimiter(count)}"

          = form_with model: source, url: admin_content_source_path(source), method: :patch, class: "flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2" do |f|
            label.inline-flex.shrink-0.items-center.gap-1.text-sm
              = f.check_box :enabled
              = t("admin.sources.enabled")
            label.inline-flex.shrink-0.items-center.gap-1.text-sm
              = f.check_box :enabled_for_admins
              = t("admin.sources.enabled_for_admins")
            = f.submit t("admin.save"), class: "shrink-0 rounded-md bg-primary px-3 py-1 text-xs font-medium text-primary-foreground hover:opacity-90 cursor-pointer"

        - if source.notes.present?
          p.text-xs.text-muted-foreground = source.notes
