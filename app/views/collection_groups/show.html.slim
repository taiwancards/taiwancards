- content_for(:title, @group.name)

.py-6.space-y-5
  header.flex.flex-wrap.items-start.justify-between.gap-3
    div.min-w-0.space-y-1
      h1.truncate.text-2xl.font-bold.tracking-tight = @group.name
      p.text-sm.text-muted-foreground = t("groups.decks_count", count: @group.collections_count)
    .flex.shrink-0.flex-wrap.gap-2
      = button_to t("shares.share_group"), share_group_path(@group), method: :post, class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
      = link_to t("groups.back"), desks_path, class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"

  = form_with url: group_path(@group), method: :patch, scope: :collection_group, class: "flex flex-wrap items-end gap-2" do |form|
    .min-w-0.flex-1.space-y-1
      = form.label :name, t("groups.name_label"), class: "block text-xs font-medium text-muted-foreground"
      = form.text_field :name, value: @group.name, class: "w-full rounded-lg border border-border bg-card px-3 py-2 text-sm"
    = form.submit t("common.save"), class: "shrink-0 rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted cursor-pointer"
    = button_to t("common.delete"), group_path(@group), method: :delete, form: {data: {turbo_confirm: t("groups.delete_confirm")}}, class: "shrink-0 rounded-lg border border-border px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-muted"

  - if @decks.any?
    p.text-xs.text-muted-foreground = t("desks.reorder_hint")
    .grid.gap-3 class="sm:grid-cols-2 xl:grid-cols-3" data-controller="sortable" data-sortable-url-value=reorder_group_decks_path(@group)
      - @decks.each do |deck|
        = render("collections/deck_card", deck: deck, sortable: true, group: @group)
  - else
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("groups.empty")

  section.rounded-xl.border.border-border.p-4.space-y-3
    p.text-sm.font-medium = t("groups.add_deck")
    p.text-xs.text-muted-foreground = t("groups.add_deck_hint")
    - if @available.any?
      = form_with url: group_decks_path(@group), method: :post, class: "space-y-3" do |form|
        .grid.gap-2 class="sm:grid-cols-2"
          - @available.each do |deck|
            label.flex.cursor-pointer.items-center.gap-2.rounded-lg.border.border-border.px-3.py-2.text-sm class="has-[:checked]:border-primary has-[:checked]:bg-primary/10"
              = check_box_tag "deck_ids[]", deck.id, false, class: "size-4 shrink-0 rounded border-border"
              span.min-w-0.truncate = deck.name
              span.shrink-0.text-xs.text-muted-foreground = t("desks.items_count", count: deck.items_count)
        = form.submit t("groups.add_deck"), class: "rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted cursor-pointer"
    - else
      p.text-sm.text-muted-foreground = t("groups.no_available")
