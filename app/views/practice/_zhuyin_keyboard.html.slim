- controller = local_assigns.fetch(:controller)
- layout = local_assigns.fetch(:layout)

.p-1 class="bg-muted/30 sm:rounded-2xl sm:border sm:border-border sm:p-3"
  .grid class="gap-0.5 sm:gap-1" style="grid-template-columns: repeat(24, minmax(0, 1fr))"
    - layout.each_with_index do |row, index|
      - row.each_with_index do |cell, position|
        button.flex.flex-col.items-center.justify-center.rounded-lg.border.border-border.bg-card.transition-colors[
          type="button" data-key=cell[:key] data-hit="false"
          data-action="#{controller}#tap" *{"data-#{controller}-target" => "key"}
          style=("grid-column: #{index + 1} / span 2" if position.zero?)
          class="col-span-2 h-11 sm:h-14 hover:bg-muted data-[hit=true]:bg-brand data-[hit=true]:text-white" ]
          span.font-semibold.text-base lang="zh-TW" class="sm:text-lg" = cell[:symbol] || cell[:tone]
          span.text-muted-foreground class="text-[10px]" = cell[:key] == " " ? "␣" : cell[:key]
  .flex.justify-center.pt-1 class="gap-0.5 sm:gap-1"
    button.flex.min-w-20.items-center.justify-center.rounded-lg.border.border-border.bg-card.text-lg.transition-colors[
      type="button" data-key="Backspace" aria-label="Backspace"
      data-action="#{controller}#tap" class="h-11 hover:bg-muted sm:h-12 sm:min-w-24" ] ⌫
    button.flex.min-w-20.items-center.justify-center.rounded-lg.border.border-border.bg-card.text-lg.transition-colors[
      type="button" data-key="Enter" aria-label="Enter"
      data-action="#{controller}#tap" class="h-11 hover:bg-muted sm:h-12 sm:min-w-24" ] ⏎
