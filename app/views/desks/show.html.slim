- content_for(:title, t("languages.zh-TW"))

.py-6.space-y-5
  header.flex.flex-wrap.items-start.justify-between.gap-x-4.gap-y-2
    = render("shared/page_help", key: "desk", title: t("nav.today"))
    = link_to profile_path(anchor: "goal"), class: "inline-flex min-h-11 items-center gap-1.5 rounded-full border border-border px-3 text-xs hover:bg-muted md:min-h-8" do
      span.text-muted-foreground = t("desk.goal_label")
      span.font-semibold = t("goals.options.#{@home.layout}.short")
      span.text-primary = t("desk.goal_change")

  = render("desks/layouts/#{@home.layout}", home: @home)
