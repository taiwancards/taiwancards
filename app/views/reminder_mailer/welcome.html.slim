p style="margin:0 0 12px;font-size:22px;font-weight:700;line-height:1.3;color:#111111;" = t("#{@key}.title")
- t("#{@key}.body").each do |paragraph|
  p style="margin:0 0 14px;" = paragraph
table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 10px;"
  - t("#{@key}.features").each do |feature|
    tr
      td style="padding:10px 0;border-top:1px solid #e7e5e4;"
        p style="margin:0 0 2px;font-size:15px;font-weight:700;color:#111111;" = feature[:title]
        p style="margin:0;font-size:15px;line-height:1.55;" = feature[:text]
p style="margin:14px 0 0;" = t("#{@key}.outro")
