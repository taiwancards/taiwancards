- if @delivery.count.positive?
  p style="margin:0;font-size:44px;font-weight:700;line-height:1;color:#111111;" = @delivery.count
p style="margin:12px 0 8px;font-size:20px;font-weight:700;line-height:1.3;color:#111111;" = t("#{@key}.title", **@vars)
- Array.wrap(t("#{@key}.body", **@vars)).each do |paragraph|
  p style="margin:0 0 12px;" = paragraph
