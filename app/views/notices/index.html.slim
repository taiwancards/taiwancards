- content_for(:title, t("notices.title"))

.py-6.space-y-5
  header.space-y-1
    = render("shared/page_help", key: "notices", title: t("notices.title"))
    p.max-w-2xl.text-sm.text-muted-foreground = t("notices.subtitle")

  .grid.gap-3 class="md:grid-cols-2 xl:grid-cols-3"
    - @groups.each do |situation, notices|
      section.min-w-0.space-y-2.rounded-xl.border.border-border.bg-card.p-4
        = link_to notices_situation_path(situation: situation), class: "group block space-y-0.5" do
          h2.text-base.font-semibold class="group-hover:underline" = t("notices.situations.#{situation}.name")
          p.text-xs.leading-relaxed.text-muted-foreground = t("notices.situations.#{situation}.lede")
        ul.divide-y.divide-border
          - notices.each do |notice|
            li
              = link_to notices_situation_path(situation: situation, anchor: notice.id),
                class: "flex min-h-11 flex-wrap items-baseline gap-x-2 py-1.5 text-sm hover:text-primary md:min-h-0" do
                span.font-medium lang="zh-TW" = notice.zh
                = notice_text(:span, notice.names, class: "text-xs text-muted-foreground")

  p.text-xs.text-muted-foreground = t("notices.disclaimer")
