.flex.flex-wrap.items-center.gap-2.text-xs.text-muted-foreground
  - SentenceProfile::SCHEMES.each_key do |scheme|
    - level = profile.level_for(scheme)
    - next if level.blank?
    - exact = profile.exact_for?(scheme)
    span.inline-flex.items-center.gap-1.rounded class=("px-1.5 py-0.5 #{exact ? "bg-emerald-500/15 text-emerald-700" : "bg-amber-500/15 text-amber-700"}")
      = t("sentences.schemes.#{scheme}")
      = scheme_level_label(scheme, level)
      - unless exact
        span title=t("sentences.approximate_hint", count: profile.unknown_count) ≈
  - sources.filter_map(&:register).uniq.each do |register|
    = link_to t("admin.sources.registers.#{register}"), sentences_path(registers: [register]), class: "relative rounded bg-muted px-1.5 py-0.5 hover:bg-muted-foreground/20"
