- content_for(:title, t("cangjie.title"))

.py-6.space-y-6.pinyin-locked.zhuyin-locked
  header.space-y-1
    = render("shared/page_help", key: "cangjie", title: t("cangjie.title"))

  - unless @available
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("cangjie.data_missing")

  - if @available
    .space-y-4[
      data-controller="cangjie" data-cangjie-url-value=SharedAssets.url_for("json", CangjieController::DATA) ]

      textarea.w-full.rounded-xl.border.border-border.bg-card.px-4.py-3.text-2xl.leading-relaxed[
        lang="zh-TW" rows="3" placeholder=t("cangjie.output_placeholder")
        autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false"
        data-cangjie-target="output" data-action="keydown->cangjie#keydown beforeinput->cangjie#beforeinput" ]

      .flex.items-center.gap-3.text-sm
        span.text-muted-foreground = t("cangjie.code") + ":"
        span.font-mono.text-lg.uppercase.tracking-widest.min-w-16 data-cangjie-target="code"
        span.text-lg lang="zh-TW" data-cangjie-target="radicals"
      .flex.flex-wrap.gap-1.min-h-9 data-cangjie-target="candidates"

      .space-y-1.select-none
        - @rows.each do |row|
          .flex.justify-center class="gap-0.5 sm:gap-1"
            - row.each do |letter|
              button.flex.flex-col.items-center.justify-center.rounded-lg.border.border-border.bg-card.transition-colors[
                type="button" class="h-12 w-8 hover:bg-muted active:bg-primary/20 sm:h-14 sm:w-14"
                data-cangjie-target="key" data-key=letter data-action="cangjie#press" ]
                span.text-lg.font-medium lang="zh-TW" = @keys[letter]
                span.text-muted-foreground class="text-[10px] uppercase" = letter
        .flex.justify-center.pt-1 class="gap-0.5 sm:gap-1"
          button.flex.items-center.justify-center.rounded-lg.border.border-border.bg-card.text-lg.transition-colors[
            type="button" class="h-12 w-14 hover:bg-muted active:bg-primary/20 sm:h-12 sm:w-20"
            aria-label="Backspace" data-action="cangjie#backspace" ] ⌫
          button.flex.h-12.flex-1.items-center.justify-center.rounded-lg.border.border-border.bg-card.text-lg.transition-colors[
            type="button" class="max-w-72 hover:bg-muted active:bg-primary/20"
            aria-label="Space" data-action="cangjie#space" ] ␣
          button.flex.items-center.justify-center.rounded-lg.border.border-border.bg-card.text-lg.transition-colors[
            type="button" class="h-12 w-14 hover:bg-muted active:bg-primary/20 sm:h-12 sm:w-20"
            aria-label="Clear" data-action="cangjie#clear" ] ✕

      p.text-center.text-xs.text-muted-foreground = t("cangjie.hint")
