- if pages > 1
  nav.flex.items-center.justify-center.gap-3.pt-2
    - if page > 1
      = link_to "←", path.call(page - 1), class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
    span.text-sm.text-muted-foreground = t("words.page", page: page, pages: pages)
    - if page < pages
      = link_to "→", path.call(page + 1), class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
