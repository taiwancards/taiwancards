header.sticky.top-0.z-40.border-b.border-border
  .pointer-events-none.absolute.inset-0[
    aria-hidden="true" class="-z-10 bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70" ]
  .mx-auto.flex.h-14.w-full.max-w-3xl.items-center.gap-2.px-4
    = link_to root_path, class: "flex shrink-0 items-center gap-2 text-lg tracking-tight" do
      = image_tag "/icon.svg?v=6", alt: "", width: 36, height: 36, class: "size-9 shrink-0"
      span.hidden class="sm:inline"
        span.font-bold Taiwan
        span.font-normal.text-muted-foreground Cards

    .relative.min-w-0.flex-1[ data-tour="search" data-controller="search search-pad" data-search-url-value=search_path ]
      .relative
        span.pointer-events-none.absolute.inset-y-0.left-0.flex.items-center.text-muted-foreground class="pl-2.5"
          = icon(:search, css: "size-4")
        input.w-full.rounded-full.border.border-border.bg-muted.pl-8.text-sm[
          type="search" placeholder=t("search.placeholder") aria-label=t("search.title")
          class="py-1.5 pr-10"
          data-search-target="input" data-search-pad-target="field" autocomplete="off"
          data-action="input->search#input focus->search#focus keydown->search#keydown" ]
        button.absolute.inset-y-0.right-0.flex.items-center.px-3.text-muted-foreground[
          type="button" data-action="search-pad#toggle" data-search-pad-target="opener"
          title=t("search.pad.open") aria-label=t("search.pad.open") class="hover:text-foreground" ]
          = icon(:keyboard, css: "size-4")
      .absolute.left-0.top-full.z-50.mt-2.flex.items-start.gap-2[
        class="max-md:fixed max-md:inset-x-2 max-md:top-14 max-md:mt-1" ]
        .hidden.overflow-hidden.rounded-xl.border.border-border.bg-background.shadow-xl[
          class="w-[min(30rem,86vw)] max-md:w-auto max-h-[45vh] xl:max-h-[70vh] overflow-y-auto"
          data-search-target="panel" ]
          div data-search-target="results"

        = render "shared/search_pad"

    .flex.shrink-0.items-center.gap-2
      = link_to new_desk_path, data: {tour: "new-desk"}, class: "inline-flex size-9 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-sm transition-opacity hover:opacity-90", title: t("desks.new"), aria: {label: t("desks.new")} do
        = icon(:plus, css: "size-5", stroke: 2.2)

      = render "shared/script_prefs", inside_app: authenticated?, compact: true


= render "shared/subnav"
