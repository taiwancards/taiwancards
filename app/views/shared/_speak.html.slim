- audio = local_assigns[:audio] || audio_for(local_assigns[:lexeme])
- if audio
  button.inline-flex.shrink-0.items-center.justify-center.rounded-full.border.border-border.text-muted-foreground.transition-colors[
    type="button"
    class=(local_assigns[:size] == :sm ? "h-6 w-6 hover:bg-muted hover:text-foreground" : "h-8 w-8 hover:bg-muted hover:text-foreground")
    title=audio_source_title(audio)
    aria-label=t("audio.play")
    data-controller="audio"
    data-audio-url-value=audio[:url]
    data-audio-stop-ms-value=audio[:stop_ms]
    data-action="audio#play" ]
    svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
      path d="M8 5v14l11-7z"
