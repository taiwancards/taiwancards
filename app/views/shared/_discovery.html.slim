- if suggestion
  section.rounded-2xl.border.border-border.bg-card.p-4.text-left
    h2.text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("discovery.title")
    = link_to discovery_path(suggestion), class: "-mx-2 mt-1 flex min-h-11 items-start gap-3 rounded-lg px-2 py-2 hover:bg-muted" do
      = icon(discovery_icon(suggestion), css: "mt-0.5 size-5 shrink-0 text-brand")
      span.min-w-0
        span.block.text-2xs.font-medium.uppercase.tracking-wide.text-brand = t("discovery.kinds.#{suggestion.kind}")
        span.block.text-sm.font-semibold.leading-snug = discovery_title(suggestion)
        span.mt-0.5.block.text-xs.leading-relaxed.text-muted-foreground = discovery_body(suggestion)
