- current = current_user.goal

.grid.gap-3.sm:grid-cols-3
  - User::GOALS.each do |goal|
    - chosen = goal == current
    = button_to goal_path, method: :patch, params: {goal:}, form_class: "contents", autofocus: local_assigns[:autofocus] && goal == User::GOALS.first,
      aria: {pressed: chosen},
      class: class_names("flex h-full w-full cursor-pointer flex-col items-start gap-2 rounded-2xl border p-4 text-left transition hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary", chosen ? "border-primary bg-brand-soft" : "border-border bg-card hover:bg-muted/40") do
      span.flex.items-center.gap-2
        = icon(goal_icon(goal), css: "size-5 shrink-0 text-primary")
        span.text-base.font-bold.leading-snug = t("goals.options.#{goal}.title")
      span.text-sm.leading-relaxed.text-muted-foreground = t("goals.options.#{goal}.body")
      ul.hidden.space-y-1.text-xs.leading-snug.text-muted-foreground.sm:block
        - t("goals.options.#{goal}.home").each do |line|
          li.flex.gap-1.5
            span.text-primary aria-hidden="true" = "·"
            span = line
      - if chosen
        span.mt-auto.pt-1.text-xs.font-semibold.text-primary = t("goals.current")
