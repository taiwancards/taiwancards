nav.sticky.z-30.hidden.border-b.border-border.md:block style="top: 3.5rem" class="bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70"
  .mx-auto.flex.flex-wrap.items-stretch.justify-center.gap-0.px-2 class=page_width_class
    - language_nav.each do |entry|
      - active = nav_entry_active?(entry)
      - if entry[:type] == :link
        = link_to entry[:path], class: nav_top_classes(active) do
          = icon(entry[:key], css: "size-4", stroke: active ? 2 : 1.6)
          span.hidden class="min-[420px]:inline" = entry[:label]
      - else
        .relative data-controller="menu"
          button type="button" data-action="menu#toggle" class=nav_top_classes(active)
            = icon(entry[:key], css: "size-4", stroke: active ? 2 : 1.6)
            span = entry[:label]
            - if recommended_group?(entry)
              span.size-1.5.rounded-full.bg-brand aria-hidden="true"
            = icon(:chevron_down, css: "size-3.5 opacity-60")
          .absolute.left-0.top-full.z-50.hidden.mt-1.w-56.rounded-xl.border.border-border.bg-background.p-1.shadow-xl data-menu-target="panel"
            - entry[:items].each do |key, label, path|
              - item_active = current_page?(path)
              = link_to path, class: nav_menu_item_classes(item_active) do
                = icon(key, css: "size-4", stroke: item_active ? 2 : 1.6)
                span.flex-1 = label
                - if recommended?(path)
                  = render "shared/for_you"
