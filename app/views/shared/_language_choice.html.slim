nav.inline-flex.shrink-0.items-center.gap-0.5.rounded-full.border.border-border.p-0.5 aria-label=t("nav.interface_language")
  - I18n.available_locales.each do |code|
    - if code == I18n.locale
      span.inline-flex.min-h-9.items-center.rounded-full.bg-primary.px-3.text-xs.font-semibold.text-primary-foreground lang=code aria-current="true"
        = t("locales.#{code}")
    - else
      = button_to t("locales.#{code}", locale: code), locale_path(code, locale: nil), method: :post, form: {class: "contents"}, lang: code,
        class: "inline-flex min-h-9 cursor-pointer items-center rounded-full px-3 text-xs font-medium text-muted-foreground hover:text-foreground"
