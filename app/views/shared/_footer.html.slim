footer.border-t.border-border.text-muted-foreground class="mt-10"
  .mx-auto.w-full.px-4.pt-4.md:hidden class=page_width_class
    .flex.justify-center
      = render "shared/script_prefs", inside_app: authenticated?, readings: true
  .mx-auto.w-full.px-4.pt-8.text-sm.flex.flex-wrap.items-center.gap-x-2.gap-y-1[
    class="#{page_width_class} pb-[calc(env(safe-area-inset-bottom)+5rem)] md:pb-8" ]
    span
      => t("footer.made")
      ' 🇹🇼
      => t("footer.by")
      = link_to "丹丹", "https://github.com/denpatin", rel: "noopener", target: "_blank", class: "font-medium text-foreground hover:underline"
      = " · #{launch_year_range}"
    span ·
    = link_to t("footer.licenses"), licenses_path, class: "text-foreground hover:underline"
    span ·
    = link_to t("footer.privacy"), privacy_path, class: "text-foreground hover:underline"
    span ·
    = link_to t("footer.terms"), terms_path, class: "text-foreground hover:underline"
