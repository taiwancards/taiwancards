- if variants.size > 1
  .flex.flex-wrap.items-baseline.gap-x-2.gap-y-1.text-xs
    span.text-muted-foreground = t("words.variant_forms")
    - variants.each_with_index do |variant, index|
      - main = index.zero?
      - css = "inline-flex items-baseline gap-1 rounded-lg border px-2 py-0.5 #{main ? "border-brand/40 bg-brand/5" : "border-border"}"
      - body = capture do
        span.text-sm.font-semibold lang="zh-TW" class=(main ? "text-brand" : nil) = variant.text
        - if main
          span.text-muted-foreground = t("words.variant_main")
      - if variant.text == current
        span class="#{css} ring-1 ring-border"
          = body
      - else
        = link_to dict_entry_path(variant.text), class: "#{css} transition-colors hover:bg-muted" do
          = body
