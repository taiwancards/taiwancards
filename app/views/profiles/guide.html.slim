= render layout: "profiles/shell" do
  section.space-y-5 data-tour="profile-guide"
    div
      h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("intro.guide.title")
      p.mt-1.text-sm.leading-relaxed.text-muted-foreground = t("intro.guide.body")

    - language_nav.each do |group|
      section.rounded-2xl.border.border-border.bg-card.p-5.space-y-3
        header.flex.flex-wrap.items-start.justify-between.gap-3
          .min-w-0
            .flex.items-center.gap-2
              = icon(group[:key], css: "size-4 shrink-0 text-muted-foreground")
              h3.font-semibold = group[:label]
            p.mt-1.text-xs.leading-relaxed.text-muted-foreground
              = t("nav.group_lede.#{group[:id]}")

          .flex.shrink-0.flex-wrap.items-center.gap-2
            - guide_chapters_for(group).each do |chapter|
              - done = current_user.intro.chapter_done?(chapter.id)
              = button_to guide_chapter_label(chapter, done), intro_chapter_path(chapter.id),
                class: class_names("rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-muted",
                  done ? "border-border text-muted-foreground" : "border-brand text-brand")

        ul.grid.gap-2 class="sm:grid-cols-2"
          - group[:items].each do |key, label, path|
            li
              = link_to path, class: "flex items-center gap-2 rounded-xl border border-border px-3 py-2 text-sm hover:bg-muted" do
                = icon(key, css: "size-4 shrink-0 text-muted-foreground")
                span.min-w-0.flex-1.truncate = label
                span.shrink-0.text-muted-foreground →

    section.rounded-2xl.border.border-border.p-5.space-y-2 class="bg-muted/40"
      h3.font-semibold = t("intro.guide.replay_title")
      p.text-sm.leading-relaxed.text-muted-foreground = t("intro.guide.replay_body")
      = button_to t("intro.guide.replay_cta"), intro_start_path,
        class: "inline-flex rounded-xl border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-muted"
