- content_for(:title, t("auth.profile"))

.py-6.space-y-5
  header.flex.flex-wrap.items-center.justify-between.gap-3
    div.min-w-0
      h1.text-2xl.font-bold.tracking-tight = t("auth.profile")
      p.truncate.text-sm.text-muted-foreground = @user.email
    = button_to t("auth.logout"), logout_path, method: :delete,
      class: "rounded-md border border-border px-3 py-1.5 text-sm font-medium hover:bg-muted"

  = render "shared/tabs", tabs: profile_tabs

  - if @user.errors.any?
    .rounded-lg.border.border-red-500.px-3.py-2.text-sm.text-red-600 class="bg-red-500/10"
      = @user.errors.full_messages.to_sentence

  = yield
