= render layout: "profiles/shell" do
  section.rounded-2xl.border.border-border.bg-card.p-5.space-y-4 data-controller="autosave" data-tour="profile-level"
    .flex.items-center.justify-between.gap-3
      h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("auth.level_title")
      = render "profiles/saved_badge"

    = form_with model: @user, url: profile_path, method: :patch, class: "space-y-5",
      data: {action: "change->autosave#save"} do |form|
      = hidden_field_tag :tab, "level"

      .space-y-1
        label.block.space-y-1
          span.text-xs.font-medium.text-muted-foreground = t("auth.level_field")
          = form.select :level,
            User::LEVELS.map { |value| [level_label(value), value] },
            {selected: @user.level},
            class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"
        p.text-xs.text-muted-foreground
          = t("auth.level_note")
          = " "
          = link_to t("auth.level_test"), placement_path, class: "font-medium text-primary hover:underline"
