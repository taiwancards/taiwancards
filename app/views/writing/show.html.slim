- content_for(:title, t("writing.title"))

.py-6.space-y-6.pinyin-locked.zhuyin-locked
  header.flex.flex-wrap.items-center.justify-between.gap-3
    .space-y-1
      = render("shared/page_help", key: "writing", title: t("writing.title"))
      - if @collection
        p.text-xs.font-medium.text-primary = @collection.name
    = link_to t("writing.another"), @advance_url, class: "rounded-md border border-border px-3 py-1.5 text-sm font-medium hover:bg-muted"

  - if @lexeme.nil? || @chars.empty? || @chars.any? { |char| !char["strokes"] }
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("writing.empty")
  - else
    .mx-auto.max-w-md.space-y-6[
      data-controller="writing-quiz"
      data-writing-quiz-grade-url-value=writing_grade_path
      data-writing-quiz-advance-url-value=@advance_url
      data-writing-quiz-lexeme-id-value=@lexeme.id
      data-writing-quiz-stage-value=(@first_time ? "watch" : "recall")
      data-writing-quiz-note-watch-value=t("writing.stages.watch_note")
      data-writing-quiz-note-trace-value=t("writing.stages.trace_note")
      data-writing-quiz-note-recall-value=t("writing.hint")
      data-writing-quiz-label-good-value=t("writing.correct")
      data-writing-quiz-label-hard-value=t("writing.shaky")
      data-writing-quiz-label-again-value=t("writing.revealed") ]

      .rounded-3xl.border.border-border.bg-card.px-6.py-6.text-center.shadow-sm
        .text-xl.font-semibold = @lexeme.meaning
        - if @lexeme.reading("pinyin").present?
          .mt-1.text-sm.text-muted-foreground = @lexeme.reading("pinyin")

      - if @first_time
        ol.flex.items-center.justify-center.gap-1.text-xs.font-medium aria-label=t("writing.stages.label")
          - %w[watch trace recall].each_with_index do |stage, index|
            li.flex.items-center.gap-1
              - if index.positive?
                span.h-px.w-3.bg-border aria-hidden="true"
              button.inline-flex.min-h-11.items-center.gap-1.5.rounded-full.border.border-border.px-3.text-muted-foreground.transition-colors[
                type="button" data-writing-quiz-target="step" data-stage=stage
                data-action="writing-quiz#goto" class="md:min-h-8 hover:bg-muted" ]
                span.tabular-nums = index + 1
                span = t("writing.stages.#{stage}")

      .flex.flex-wrap.justify-center.gap-3
        - @chars.each do |char|
          .flex.flex-col.items-center.gap-1
            .text-sm.font-medium.text-muted-foreground = char["zhuyin"].presence || char["pinyin"]
            .rounded-xl.border-2.border-dashed.border-border.bg-background[
              data-writing-quiz-target="square" data-char=char["char"] data-url=character_strokes_path(char["char"], locale: nil) ]

      .flex.flex-col.items-center.gap-2
        .text-sm.font-medium.text-muted-foreground data-writing-quiz-target="status"
        .text-lg.font-semibold data-writing-quiz-target="result"
        - if @first_time
          .flex.flex-wrap.justify-center.gap-2 data-writing-quiz-target="watchActions"
            button.inline-flex.min-h-11.items-center.rounded-full.border.border-border.px-5.text-sm.font-medium[
              type="button" data-action="writing-quiz#replay" class="hover:bg-muted" ]
              = t("writing.stages.replay")
            button.inline-flex.min-h-11.items-center.rounded-full.bg-primary.px-5.text-sm.font-semibold.text-primary-foreground[
              type="button" data-action="writing-quiz#startTrace" class="hover:opacity-90" ]
              = t("writing.stages.to_trace")
        button.min-h-11.rounded-full.border.border-border.px-6.text-sm.font-medium[
          type="button" data-writing-quiz-target="reveal" data-action="writing-quiz#reveal"
          hidden=@first_time class="hover:bg-muted" ]
          = t("writing.reveal")

      p.text-center.text-xs.leading-relaxed.text-muted-foreground data-writing-quiz-target="note" = t("writing.hint")
