- field = "w-full rounded-lg border border-border bg-card px-3 py-2"
- button = "inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-lg px-4 text-sm font-semibold md:min-h-9"
- title = t("scan.default_title", time: l(Time.current, format: :short))

- if panel.open?
  section.space-y-4 data-controller="scan" data-scan-upload-url-value=scans_path(locale: nil) data-scan-edge-value=Scans::Upload::TARGET_EDGE data-scan-max-bytes-value=Scans::Upload::MAX_BYTES data-scan-min-edge-value=Scans::Upload::MIN_EDGE data-scan-max-parts-value=Scans::Submission::MAX_PARTS data-scan-tall-ratio-value=Scans::Submission::TALL_RATIO data-scan-remaining-value=panel.remaining data-scan-messages-value=t("scan.client").to_json
    p.text-sm.font-medium data-scan-target="remaining" = panel.remaining_label

    div data-scan-target="picker" hidden=panel.remaining.zero?
      label.flex.cursor-pointer.flex-col.items-center.gap-3.rounded-2xl.border-2.border-dashed.border-border.bg-card.px-4.py-8.text-center data-scan-target="zone" data-action="dragover->scan#hover dragleave->scan#leave drop->scan#drop"
        = icon(:upload, css: "size-6 text-muted-foreground")
        span.text-sm.font-medium = t("scan.drop")
        span.max-w-md.text-xs.leading-relaxed.text-muted-foreground = t("scan.drop_hint")
        input.sr-only type="file" accept="image/*" data-action="change->scan#pick" aria-label=t("scan.choose")
      .mt-3.flex.flex-wrap.gap-2
        label class="#{button} bg-primary text-primary-foreground hover:opacity-90"
          = t("scan.camera")
          input.sr-only type="file" accept="image/*" capture="environment" data-action="change->scan#pick"
        label class="#{button} border border-border hover:bg-muted"
          = t("scan.choose")
          input.sr-only type="file" accept="image/*" data-action="change->scan#pick"

    - if panel.remaining.zero?
      p.text-sm.text-muted-foreground = t("scan.refusals.quota")

    .flex.items-center.gap-3 data-scan-target="progress" hidden=true
      img.size-16.shrink-0.rounded-lg.border.border-border.object-cover data-scan-target="preview" alt=""
      p.text-sm.text-muted-foreground role="status" aria-live="polite" data-scan-target="status"

    p.rounded-lg.border.border-border.px-3.py-2.text-sm data-scan-target="error" role="alert" hidden=true

    .space-y-3 data-scan-target="result" hidden=true
      p.rounded-lg.border.border-border.px-3.py-2.text-xs.text-muted-foreground data-scan-target="note" hidden=true
      p.rounded-lg.border.border-border.px-3.py-2.text-xs.text-muted-foreground data-scan-target="changed" hidden=true
      .space-y-1
        label.text-sm.font-medium for="scan-text" = t("scan.text_label")
        textarea#scan-text class="#{field} text-base leading-relaxed" rows="10" lang="zh-TW" data-scan-target="text" maxlength=Collections::TextPreview::MAX_CHARS
        p.text-xs.text-muted-foreground = t("scan.text_hint")
      .space-y-1
        label.text-sm.font-medium for="scan-title" = t("scan.title_label")
        input#scan-title class="#{field} text-sm" type="text" maxlength="200" value=title data-scan-target="title"
      .flex.flex-wrap.gap-2
        = form_with url: desk_preview_path, method: :post, multipart: true, data: {turbo: false, action: "submit->scan#fill"} do |form|
          = form.file_field :file, id: nil, hidden: true, tabindex: -1, data: {scan_role: "file"}
          = form.hidden_field :text, value: "", id: nil, data: {scan_role: "text"}
          = form.hidden_field :name, value: "", id: nil, data: {scan_role: "title"}
          button type="submit" class="#{button} bg-primary text-primary-foreground hover:opacity-90" = t("scan.make_deck")
        = form_with url: reader_path, method: :post, scope: :reading_text, data: {turbo: false, action: "submit->scan#fill"} do |form|
          = form.hidden_field :body, value: "", id: nil, data: {scan_role: "text"}
          = form.hidden_field :title, value: "", id: nil, data: {scan_role: "title"}
          = form.hidden_field :kind, value: "article"
          button type="submit" class="#{button} border border-border hover:bg-muted" = t("scan.open_reader")
        button type="button" class="#{button} text-muted-foreground hover:bg-muted" data-action="scan#reset" data-scan-target="again" = t("scan.again")

- else
  .rounded-xl.border.border-dashed.border-border.px-4.py-10.text-center.space-y-2
    p.text-sm.font-medium = t("scan.closed.title")
    p.mx-auto.max-w-md.text-sm.text-muted-foreground = t("scan.closed.#{panel.closed_reason}")

p.max-w-prose.text-xs.leading-relaxed.text-muted-foreground = t("scan.privacy_note", hours: Scan::KEPT_FOR.in_hours.to_i)
