- content_for(:title, t("grammar.title"))
- wide_page

.py-6.space-y-6
  header.space-y-2
    h1.text-2xl.font-bold.tracking-tight = t("grammar.title")
    p.text-sm.leading-relaxed.text-muted-foreground = t("grammar.lede")

  - if @form
    p.text-sm.text-muted-foreground
      = t("grammar.for_form")
      span.ml-1.text-base.font-semibold lang="zh-TW" = @form
      = link_to t("grammar.all_levels"), grammar_path, class: "ml-3 underline underline-offset-2 hover:text-foreground"
  - else
    = render("shared/tabs", tabs: grammar_level_tabs(@levels.keys, @level))

  - @shown.sort.each do |level, lessons|
    section.space-y-3
      h2.flex.items-baseline.gap-2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground
        = t("grammar.level_label", level: level)
        span.text-xs.font-normal.normal-case = t("grammar.level_bands.#{level}")
        span.text-xs.font-normal.tabular-nums = "· #{lessons.size}"
      .grid.gap-3 class="sm:grid-cols-2 xl:grid-cols-3"
        - lessons.each do |lesson|
          - lines, head_size = grammar_head_lines(lesson)
          = link_to grammar_lesson_path(lesson.slug), class: "flex h-full min-w-0 items-center gap-3 rounded-xl border border-border bg-card p-3 transition-colors hover:bg-muted" do
            span.flex.shrink-0.flex-col.items-center.justify-center.text-center.font-semibold.leading-none[
              lang="zh-TW" class="h-14 w-16 gap-0.5 #{head_size}" ]
              - lines.each do |line|
                span = line
            .min-w-0.flex-1.space-y-1
              .text-sm.font-semibold.leading-snug class="line-clamp-2" = lesson.title(I18n.locale)
              .text-xs.leading-snug.text-muted-foreground class="line-clamp-2" lang="zh-TW"
                = lesson.formula_for(I18n.locale)
