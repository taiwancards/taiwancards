- content_for(:title, @lesson.title(I18n.locale))
- seen = Set.new

.py-6.space-y-6.reading-hints.hints-zhuyin data-controller="reading-hints"
  nav.flex.items-center.justify-between.gap-3.text-sm
    = link_to "← #{t("grammar.title")}", grammar_path, class: "text-muted-foreground hover:text-foreground"
    = render("grammar/hints")

  header.space-y-3
    h1.text-2xl.font-bold.tracking-tight = @lesson.title(I18n.locale)
    div
      span.inline-flex.rounded-lg.bg-muted.px-3.py-1.text-sm.font-medium lang="zh-TW" = @lesson.formula_for(I18n.locale)
      span.ml-2.rounded-full.border.border-border.px-2.py-0.5.text-xs.text-muted-foreground
        = t("grammar.level_label", level: @lesson.level)

  - heads = grammar_heads(@lesson, entries: @entries)
  - if heads.any?
    .-mx-4.flex.gap-2.overflow-x-auto.px-4.pb-1
      - heads.each do |head|
        - card = "flex min-w-28 shrink-0 flex-col items-center gap-1 rounded-xl border border-border bg-card px-4 py-3"
        - if head.entry
          = link_to lexeme_page_path(head.entry), class: "#{card} hover:bg-muted" do
            = render("grammar/head", head: head, lesson: @lesson)
        - else
          div class=card
            = render("grammar/head", head: head, lesson: @lesson)

  - if @lesson.excluded?
    .rounded-xl.border.border-red-500.px-4.py-3.text-sm.leading-relaxed class="bg-red-500/10"
      strong = t("grammar.not_taught")
      span<> = @lesson.exclusion_reason(I18n.locale)

  section.grammar-prose.space-y-3
    = grammar_prose(@lesson.body(I18n.locale), @lesson, seen: seen, entries: @entries)
    - if @lesson.tip(I18n.locale).present?
      .rounded-xl.border.border-amber-400.px-4.py-3.text-sm class="bg-amber-500/10"
        strong.mr-1 = t("grammar.tip")
        = grammar_prose(@lesson.tip(I18n.locale), @lesson, seen: seen, entries: @entries)

  section.space-y-3
    h2.text-sm.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("grammar.examples")
    ul.grammar-prose.space-y-2
      - @lesson.examples.each do |example|
        li.rounded-xl.border.border-border.bg-card.px-4.py-3
          .flex.items-start.gap-2
            = grammar_example_text(example, @entries)
            .flex.shrink-0.items-center.gap-2
              - if (clip = Huayu::ListeningClips.for_text(example.zh))
                button.inline-flex.items-center.justify-center.rounded-full.border.border-border.p-1.text-muted-foreground[
                  type="button" data-controller="audio"
                  data-audio-url-value=Huayu::ListeningClips.clip_url(clip.clip)
                  data-action="click->audio#play" class="hover:bg-muted hover:text-foreground"
                  aria-label=t("study.play") ]
                  = icon(:speaker, css: "size-4")
              - if example.sentence
                = link_to "→", sentence_path(example.sentence), class: "text-xs text-muted-foreground hover:text-foreground", title: t("sentences.open")
          = grammar_example_reading(example)
          - if example.translation(I18n.locale).present?
            .gloss-line = grammar_quote(example.translation(I18n.locale))

  - practice = grammar_practice_path(@lesson)
  - if practice
    = link_to practice, class: "flex items-center justify-between gap-3 rounded-xl border border-border bg-card px-4 py-3 text-sm hover:bg-muted" do
      span = t("grammar.practice_more")
      span.text-muted-foreground →

  nav.flex.justify-between.gap-3.text-sm
    - if @previous
      = link_to "← #{@previous.title(I18n.locale)}", grammar_lesson_path(@previous.slug), class: "text-muted-foreground hover:text-foreground"
    - else
      span
    - if @next
      = link_to "#{@next.title(I18n.locale)} →", grammar_lesson_path(@next.slug), class: "text-muted-foreground hover:text-foreground"
