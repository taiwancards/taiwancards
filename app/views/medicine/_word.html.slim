- lexeme = local_assigns.fetch(:lexeme)
- med = lexeme.data["med"] || {}
- pair_text = med["folk"] || med["formal"]
- pair = @by_text[pair_text] if pair_text

= render(layout: "shared/word_tile", locals: {lexeme:, tier: med["tier"]}) do
  - if pair_text.present?
    span.leading-snug.text-muted-foreground class="text-[10px]"
      => t(med["folk"] ? "medicine.folk_label" : "medicine.formal_label")
      span lang="zh-TW" = pair_text
      - if pair
        span.ml-1 lang="zh-TW" = pair.readings["zhuyin"] || pair.readings["pinyin"]
