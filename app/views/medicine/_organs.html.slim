- left = med_callouts([["大腦", 362, 86], ["靜脈", 356, 300], ["肺臟", 318, 340], ["橫膈膜", 300, 442], ["肝臟", 322, 478], ["膽囊", 366, 518], ["腎臟", 334, 602], ["大腸", 318, 630], ["盲腸", 306, 692], ["膀胱", 368, 742]], top: 70, gap: 86)
