    svg viewBox="0 0 760 900" class="h-auto w-full" role="img" aria-label=t("medicine.diagrams.organs")
      g opacity="0.75"
        ellipse cx="380" cy="96" rx="44" ry="52" style="fill: #{skin}"
        rect x="364" y="140" width="32" height="36" rx="10" style="fill: #{skin}"
        path d="M 364 170 Q 306 184 296 224 Q 288 260 292 340 L 292 560 Q 292 640 316 700 Q 330 736 352 756 L 408 756 Q 430 736 444 700 Q 468 640 468 560 L 468 340 Q 472 260 464 224 Q 454 184 396 170 Z" style="fill: #{skin}"

