- content_for(:title, t("chengyu.title"))

.py-6.space-y-5
  header.space-y-1
    = render("shared/page_help", key: "chengyu", title: t("chengyu.title"))

  - base = ->(overrides) { chengyu_path({tone: @tone, kind: @kind, grade: @grade, band: @band, q: @q.presence}.merge(overrides)) }

  = form_with url: chengyu_path, method: :get, data: { turbo_frame: "_top" } do |form|
    - {tone: @tone, kind: @kind, grade: @grade, band: @band}.compact.each do |name, value|
      = form.hidden_field name, value: value
    .flex.flex-wrap.items-center.gap-2
      = form.search_field :q, value: @q, placeholder: t("chengyu.search_placeholder"),
        class: "min-w-40 flex-1 rounded-lg border border-border bg-card px-3 py-2 text-sm"
      = form.submit t("words.search"), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90 cursor-pointer"

  .text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("chengyu.filter_level")
  nav.flex.flex-wrap.gap-1.text-sm
    = link_to t("chengyu.grades.all"), base.call(grade: nil),
      class: class_names("rounded-full px-3 py-1 font-medium", @grade.nil? ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")
    - (1..7).each do |grade|
      - count = @counts[:grade][grade.to_s].to_i
      - next if count.zero?
      = link_to base.call(grade: grade),
        class: class_names("rounded-full px-3 py-1 font-medium", @grade == grade.to_s ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted") do
        = t("words.grade", n: grade)
        span.ml-1.text-xs.opacity-70 = count
    = link_to base.call(grade: "advanced"),
      class: class_names("rounded-full px-3 py-1 font-medium", @grade == "advanced" ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted") do
      = t("chengyu.grades.advanced")
      span.ml-1.text-xs.opacity-70 = @counts[:grade]["advanced"].to_i

  - if detailed?
    .text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("chengyu.filter_tone")
    nav.flex.flex-wrap.items-center.gap-1.text-sm
      = link_to t("chengyu.tones.all"), base.call(tone: nil),
        class: class_names("rounded-full px-3 py-1 font-medium", @tone.nil? ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")
      - Huayu::ChengyuImporter::TONES.each do |tone|
        = link_to base.call(tone: tone),
          class: class_names("flex items-center gap-1.5 rounded-full px-3 py-1 font-medium",
            @tone == tone ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted") do
          span.size-2.rounded-full class=chengyu_tone_dot(tone)
          = t("chengyu.tones.#{tone}")
          span.text-xs.opacity-70 = @counts[:tone][tone].to_i

    .text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("chengyu.filter_kind")
    nav.flex.flex-wrap.gap-1.text-sm
      = link_to t("chengyu.kinds.all"), base.call(kind: nil),
        class: class_names("rounded-full px-3 py-1 font-medium", @kind.nil? ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")
      - Huayu::ChengyuImporter::KINDS.each do |kind|
        = link_to base.call(kind: kind),
          class: class_names("rounded-full px-3 py-1 font-medium", @kind == kind ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted") do
          = t("chengyu.kinds.#{kind}")
          span.ml-1.text-xs.opacity-70 = @counts[:kind][kind].to_i

    .text-xs.font-medium.uppercase.tracking-wide.text-muted-foreground = t("chengyu.filter_band")
    nav.flex.flex-wrap.gap-1.text-sm
      = link_to t("chengyu.bands.all"), base.call(band: nil),
        class: class_names("rounded-full px-3 py-1 font-medium", @band.nil? ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")
      - ChengyuController::BANDS.each do |band|
        = link_to t("chengyu.bands.#{band}"), base.call(band: band),
          class: class_names("rounded-full px-3 py-1 font-medium", @band == band ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted")

  p.text-sm.text-muted-foreground = t("chengyu.found", count: @total)

  - if @entries.empty?
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("words.empty")
  - else
    .space-y-2
      - @entries.each do |entry|
        - state = @known_ids.include?(entry.id) ? :known : (@started_ids.include?(entry.id) ? :learning : :new)
        .flex.min-w-0.items-stretch.gap-1
          = link_to dict_entry_path(entry.text), class: "flex min-w-0 flex-1 flex-col gap-1 rounded-xl border border-border bg-card px-3 py-2.5 transition-colors hover:border-primary/50 hover:bg-muted" do
            .flex.flex-wrap.items-baseline.gap-x-3.gap-y-1
              span.text-xl.font-semibold lang="zh-TW" = entry.text
              - reading = entry.reading_set.first
              - if reading
                span.text-xs.text-muted-foreground = reading["zhuyin"].presence || reading["pinyin"]
              - tone = entry.data["chengyu_tone"]
              - if detailed? && tone.present?
                span.flex.items-center.gap-1.text-xs.text-muted-foreground
                  span.size-2.rounded-full class=chengyu_tone_dot(tone)
                  = t("chengyu.tones.#{tone}")
              - if detailed?
                = score_badge(entry)
              span.ml-auto.size-2.shrink-0.rounded-full class=word_state_dot(state)
            - if entry.meaning.present?
              .text-sm.text-muted-foreground = entry.meaning
            - elsif entry.data["chengyu_gloss"].present?
              .text-sm.text-muted-foreground lang="zh-TW" = truncate(entry.data["chengyu_gloss"], length: 110)
          = render("shared/quick_add", lexeme: entry)

    = render("shared/pager", page: @page, pages: @pages, path: ->(n) { base.call(page: n) })
