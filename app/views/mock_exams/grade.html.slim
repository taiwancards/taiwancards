- level_name = t("mock.levels.#{MockExam::Bank.slug(@sheet.level)}")
- percent = @sheet.count.positive? ? (@score * 100.0 / @sheet.count).round : 0
- content_for(:title, t("mock.results_title"))

.py-6.space-y-6
  header.space-y-2
    h1.text-2xl.font-bold.tracking-tight = t("mock.results_title")
    .flex.items-baseline.gap-3
      .text-4xl.font-bold class=(percent >= 60 ? "text-emerald-500" : "text-amber-500")
        = "#{@score} / #{@sheet.count}"
      span.text-sm.text-muted-foreground = t("mock.results_percent", percent: percent)
    p.text-xs.text-muted-foreground = t("mock.results_note", level: level_name)

  .space-y-4
    - @sheet.groups.each do |group|
      section.space-y-3.rounded-xl.border.border-border.bg-card.p-4
        .text-xs.font-semibold.uppercase.tracking-wide.text-muted-foreground = t("mock.formats.#{group.format}")
        = render("stimulus", block: group.block)
        - if group.block.name(I18n.locale).present?
          p.text-sm.leading-relaxed.text-muted-foreground = group.block.name(I18n.locale)
        .space-y-4
          - group.slots.each do |slot|
            - question = slot.question
            - given = @given[slot.number]
            - correct = given == question.answer
            .space-y-2
              .flex.items-baseline.gap-2
                span.exam-number.tabular-nums class=(correct ? "bg-emerald-500/15 text-emerald-600" : "bg-red-500/15 text-red-500")
                  = slot.number
                div.min-w-0
                  - if question.ask.present?
                    p.text-base.leading-relaxed lang="zh-TW" = question.ask
                    - if question.ask_name(I18n.locale).present?
                      p.text-xs.text-muted-foreground = question.ask_name(I18n.locale)
                  - else
                    p.text-base.leading-relaxed.text-muted-foreground lang="zh-TW" = question.slot
              .flex.flex-wrap.gap-2.text-sm
                - question.options.each_with_index do |option, index|
                  - state = index == question.answer ? "border-emerald-500 text-emerald-600" : (index == given ? "border-red-500 text-red-500" : "border-border text-muted-foreground")
                  span.rounded-lg.border.px-2.py-1 class=state lang="zh-TW"
                    = "(#{("A".ord + index).chr}) #{option}"
              - if question.note(I18n.locale).present?
                p.text-xs.leading-relaxed.text-muted-foreground = question.note(I18n.locale)

  .flex.flex-wrap.gap-3
    = link_to t("mock.try_again"), mock_exam_path(level: MockExam::Bank.slug(@sheet.level)), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
    = link_to t("mock.back"), mock_exams_path, class: "rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted"
