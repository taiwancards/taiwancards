- card = "relative flex min-w-0 flex-col rounded-2xl border border-border bg-card p-4 transition-colors hover:border-primary/60 sm:p-5"
- badge = "flex size-10 shrink-0 items-center justify-center rounded-xl border border-border bg-brand-soft text-brand"

.grid.gap-3 class="sm:grid-cols-2"
  - door_cards.each do |door|
    article class=card data-door=door[:key]
      .flex.items-start.gap-3
        span class=badge aria-hidden="true"
          = icon(door[:glyph], css: "size-5")
        .min-w-0
          h2.text-base.font-semibold.leading-snug
            = link_to t("doors.#{door[:key]}.door"), door[:path],
              class: "after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-primary"
          p.mt-1.text-sm.leading-relaxed.text-muted-foreground = t("doors.#{door[:key]}.pitch")
      - if door[:extra]
        = link_to(*door[:extra],
          class: "relative z-10 mt-2 inline-flex min-h-11 items-center self-start pl-13 text-sm font-medium text-primary underline-offset-2 hover:underline md:min-h-8")

  article class=card data-door="lookup"
    .flex.items-start.gap-3
      span class=badge aria-hidden="true"
        = icon(:search, css: "size-5")
      .min-w-0.flex-1
        h2.text-base.font-semibold.leading-snug
          label for="door-lookup" = t("doors.lookup.door")
        = form_with url: lookup_path, method: :get, class: "mt-2 flex gap-2" do
          input#door-lookup.min-h-11.min-w-0.flex-1.rounded-lg.border.border-border.bg-background.px-3.text-base[
            type="search" name="q" lang="zh-TW" placeholder="學校" required=true maxlength=DoorsController::QUERY_LIMIT
            autocomplete="off" enterkeyhint="search" ]
          button.min-h-11.shrink-0.cursor-pointer.rounded-lg.bg-primary.px-4.text-sm.font-semibold.text-primary-foreground type="submit" class="hover:opacity-90"
            = t("doors.lookup.go")
        p.mt-2.text-xs.leading-relaxed.text-muted-foreground = t("doors.lookup.note")
