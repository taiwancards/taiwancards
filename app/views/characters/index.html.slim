- content_for(:title, t("characters.title"))
- wide_page

.py-6.space-y-6
  header.flex.flex-wrap.items-start.justify-between.gap-3
    .space-y-1
      = render("shared/page_help", key: "characters", title: t("characters.title"))
    .flex.flex-wrap.items-center.gap-2
      = link_to t("hanzi.title"), hanzi_path, class: "rounded-md border px-3 py-1.5 text-sm font-medium transition-colors border-brand text-brand hover:bg-brand/10"
      = link_to t("radicals.title"), radicals_path, class: "rounded-md border border-border px-3 py-1.5 text-sm font-medium hover:bg-muted"

  = form_with url: characters_path, method: :get, data: { turbo_frame: "_top" } do |form|
    .flex.flex-wrap.items-center.gap-2
      .relative.flex-1.min-w-40
        = form.search_field :q, value: params[:q], placeholder: t("characters.search_placeholder"),
          class: "w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm"
      - if params[:radical].present?
        = form.hidden_field :radical, value: params[:radical]
      = form.submit t("characters.search"), class: "rounded-md border border-border px-3 py-1.5 text-sm font-medium hover:bg-muted cursor-pointer"
      - if params[:q].present? || params[:radical].present? || @component.present?
        = link_to t("characters.clear"), characters_path, class: "rounded-md px-3 py-1.5 text-sm text-muted-foreground hover:bg-muted"

  - if @component.present?
    .flex.flex-wrap.items-center.gap-2.rounded-xl.border.border-border.p-3 class="bg-brand/5"
      span.text-sm.text-muted-foreground = t("characters.by_component")
      span.text-2xl.font-semibold.text-brand lang="zh-TW" = @component
      span.text-sm.text-muted-foreground = t("characters.found", count: @total)
      = link_to t("hanzi.title"), hanzi_path, class: "ml-auto text-sm text-brand hover:underline"

  section
    .flex.flex-wrap class="gap-1.5"
      - if params[:radical].present?
        span.rounded-full.bg-primary.px-2.py-1.text-xs.font-semibold.text-primary-foreground
          = t("characters.radical") + " " + params[:radical]
        = link_to t("characters.all_radicals"), characters_path(q: params[:q]), class: "inline-flex min-h-11 items-center rounded-full border border-border px-2 text-xs hover:bg-muted md:min-h-7"
      - else
        - @radicals.first(48).each do |radical, count|
          = link_to characters_path(radical: radical, q: params[:q]),
            class: "inline-flex min-h-11 items-center rounded-full border border-border px-2 text-xs text-muted-foreground hover:bg-muted md:min-h-7" do
            span lang="zh-TW" = radical
            span.ml-1 class="text-[10px] opacity-60" = count

  - if @characters.empty?
    p.rounded-lg.border.border-dashed.border-border.px-4.py-10.text-center.text-sm.text-muted-foreground
      = t("characters.empty")
  - else
    .grid.gap-1 style="grid-template-columns: repeat(auto-fill, minmax(3.25rem, 1fr))"
      - @characters.each do |character|
        = link_to character_path(character.text),
          class: class_names("group flex aspect-square flex-col items-center justify-center rounded-lg border transition-colors",
            @studied_ids.include?(character.id) ? "border-primary/60 bg-primary/10" : "border-border hover:bg-muted") do
          span.text-2xl.leading-none lang="zh-TW" = character.text
          - reading = character.reading_set.first
          - if reading
            span.text-muted-foreground class="text-[9px] leading-none mt-0.5" = reading["zhuyin"].presence || reading["pinyin"]

  - if @pages > 1
    nav.flex.items-center.justify-center.gap-2.pt-2
      - if @page > 1
        = link_to "←", characters_path(page: @page - 1, radical: params[:radical], q: params[:q]), class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
      span.text-sm.text-muted-foreground = t("characters.page", page: @page, pages: @pages)
      - if @page < @pages
        = link_to "→", characters_path(page: @page + 1, radical: params[:radical], q: params[:q]), class: "rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
