#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [ "${CONFIRM:-}" != "yes" ]; then
  cat << 'USAGE'
Full local rebuild from source files.

  1. drop and recreate the database (needs no live connection)
  2. apply the single installation migration
  3. hand over to rake install:local — content, thresholds, vacuum, census

Everything comes from data/, dict_and_corpora/ and media/. Nothing in the
database is unreproducible from files.

Wipes EVERYTHING, including users and their progress.

  CONFIRM=yes bin/install-local
USAGE
  exit 1
fi

CORES=$(bin/rails runner 'print Install::Hardware.performance_cores' 2> /dev/null || echo 8)

bin/rails runner '
config = ActiveRecord::Base.connection_db_config.configuration_hash
names = [config[:database], config[:database].to_s.sub(/_development\z/, "_test")].uniq
ActiveRecord::Base.establish_connection(config.merge(database: "postgres"))
names.each do |name|
  ActiveRecord::Base.connection.select_value(
    "SELECT count(pg_terminate_backend(pid)) FROM pg_stat_activity " \
    "WHERE datname = #{ActiveRecord::Base.connection.quote(name)} AND pid <> pg_backend_pid()"
  )
end
' > /dev/null

bin/rails db:drop db:create db:migrate

PGOPTIONS="-c synchronous_commit=off -c maintenance_work_mem=2GB -c work_mem=256MB -c max_parallel_maintenance_workers=$CORES" \
  CONFIRM=yes FORCE=yes bin/rails install:local
