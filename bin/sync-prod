#!/usr/bin/env bash
set -o errexit
set -o pipefail

cd "$(dirname "$0")/.."

if [ -z "${PROD_DATABASE_URL:-}" ]; then
  echo "PROD_DATABASE_URL is required" >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "working tree is dirty — commit and push first" >&2
  exit 1
fi

local_head=$(git rev-parse HEAD)
remote_head=$(git ls-remote origin -h refs/heads/main | cut -f1)
if [ "$local_head" != "$remote_head" ]; then
  echo "HEAD $local_head is not origin/main $remote_head — push first so Render builds the code that ran this sync" >&2
  exit 1
fi

target=$(ruby -ruri -e 'u = URI(ENV.fetch("PROD_DATABASE_URL")); puts "#{u.host} #{u.path.delete_prefix("/")}"')
echo "target: $target"
echo "note: if data/ changed, run bin/distribute runtime first so Render hydrates the same files"

if [ "${1:-}" != "--yes" ]; then
  printf "type sync to run deploy:sync against this database: "
  read -r answer
  if [ "$answer" != "sync" ]; then
    echo "aborted"
    exit 1
  fi
fi

export RAILS_ENV=production
export DATABASE_URL="$PROD_DATABASE_URL"
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-sync-prod}"
export PG_STATEMENT_TIMEOUT=0
export PG_LOCK_TIMEOUT=10s

bin/rails db:abort_if_pending_migrations
time bin/rails deploy:sync
