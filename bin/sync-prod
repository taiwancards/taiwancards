#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
. bin/_env.sh
. bin/_lib.sh
load_env

[ -n "${PROD_DATABASE_URL:-}" ] || die "PROD_DATABASE_URL is not set; see .env.dev"
require_pushed_head

target=$(ruby -ruri -e 'u = URI(ENV.fetch("PROD_DATABASE_URL")); puts "#{u.host} #{u.path.delete_prefix("/")}"')
echo "target: $target"
echo "note: if data/ changed, run bin/distribute runtime first so Render hydrates the same files"

if [ "${1:-}" != "--yes" ]; then
  printf "type sync to run deploy:sync against this database: "
  read -r answer
  [ "$answer" = "sync" ] || die "aborted"
fi

export RAILS_ENV=production
export DATABASE_URL="$PROD_DATABASE_URL"
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-sync-prod}"
export PG_STATEMENT_TIMEOUT=0
export PG_LOCK_TIMEOUT=10s

bin/rails db:abort_if_pending_migrations
time bin/rails deploy:sync
