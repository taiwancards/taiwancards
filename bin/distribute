#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/_env.sh
load_env

ARCHIVE_DIRS=(
  dict_and_corpora
  media/pronunciation
  data/pronunciation/tokens
  data/pronunciation/tokens_mainland
  data/corpora
)

MEDIA_DIRS=(moe_audio moe_audio_words cns_voice)
IMMUTABLE="public, max-age=31536000, immutable"
REMOTE_ROOT=/var/data

UNPACKED_FROM_XZ=(dict_and_corpora/corpora/moedict/dict-revised.json)

usage() {
  cat << 'TEXT'
usage: bin/distribute [archive|media|assets|disk|all|pull|status] [--dry-run]

  archive  source corpora and the speech corpus      -> private R2 bucket
  media    MOE and CNS11643 audio clips              -> public R2 bucket behind the CDN
  assets   web fonts and browser data files          -> public assets bucket behind the CDN
  runtime  everything the running app reads         -> private runtime bucket
  disk     dictionaries, templates, restricted audio -> /var/data on Render
  all      archive, media, assets, runtime

  pull     restore the archive from R2 onto this machine
  status   how much each bucket holds

Every target is incremental: unchanged files are compared and skipped.
TEXT
  exit 64
}

need() {
  for var in "$@"; do
    [ -n "${!var:-}" ] || {
      echo "distribute: $var is not set — see .env.dev" >&2
      exit 1
    }
  done
}

r2() {
  need R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
  export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
  export AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
  export AWS_DEFAULT_REGION=auto
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
  export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  aws s3 "$@" --endpoint-url "$R2_ENDPOINT"
}

r2api() {
  need R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
  export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
  export AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
  export AWS_DEFAULT_REGION=auto
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
  export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  aws s3api "$@" --endpoint-url "$R2_ENDPOINT"
}

sha() {
  if command -v shasum > /dev/null; then shasum -a 256; else sha256sum; fi
}

sha_file() {
  sha < "$1" | cut -d' ' -f1
}

sha_tree() {
  find "$1" -type f | LC_ALL=C sort | tr '\n' '\0' | xargs -0 shasum -a 256 | sha | cut -d' ' -f1
}

remote_sha() {
  r2api head-object --bucket "$R2_RUNTIME_BUCKET" --key "$1" \
    --query 'Metadata.sha256' --output text 2> /dev/null || true
}

skip_args() {
  local dir=$1 file
  SKIP=()
  for file in "${UNPACKED_FROM_XZ[@]}"; do
    case "$file" in "$dir"/*) SKIP+=(--exclude "${file#"$dir"/}") ;; esac
  done
}

do_archive() {
  need R2_BUCKET
  echo "== archive -> s3://$R2_BUCKET"
  for dir in "${ARCHIVE_DIRS[@]}"; do
    [ -d "$dir" ] || {
      echo "   skip $dir (absent)"
      continue
    }
    echo "   $dir"
    skip_args "$dir"
    r2 sync "$dir" "s3://$R2_BUCKET/$dir" --no-progress \
      ${SKIP[@]+"${SKIP[@]}"} ${DRY[@]+"${DRY[@]}"}
  done
}

do_assets() {
  need R2_ASSETS_BUCKET
  echo "== assets -> s3://$R2_ASSETS_BUCKET"

  if [ -d storage/fonts ]; then
    echo "   fonts"
    r2 sync storage/fonts "s3://$R2_ASSETS_BUCKET/fonts" \
      --content-type font/woff2 --cache-control "$IMMUTABLE" \
      --exclude '*' --include '*.woff2' \
      --no-progress ${DRY[@]+"${DRY[@]}"}
  fi

  if [ -d storage/json ]; then
    echo "   json"
    r2 sync storage/json "s3://$R2_ASSETS_BUCKET/json" \
      --content-type application/json --cache-control "$IMMUTABLE" \
      --exclude '*' --include '*.json' \
      --no-progress ${DRY[@]+"${DRY[@]}"}
  fi
}

media_type() {
  case "$1" in
  cns_voice) echo audio/mpeg ;;
  *) echo audio/ogg ;;
  esac
}

do_media() {
  need R2_MEDIA_BUCKET
  echo "== media -> s3://$R2_MEDIA_BUCKET"
  for dir in "${MEDIA_DIRS[@]}"; do
    local src="media/$dir/audio"
    [ -d "$src" ] || {
      echo "   skip $dir (absent)"
      continue
    }
    echo "   $dir"
    r2 sync "$src" "s3://$R2_MEDIA_BUCKET/$dir/audio" \
      --content-type "$(media_type "$dir")" --cache-control "$IMMUTABLE" \
      --no-progress ${DRY[@]+"${DRY[@]}"}
  done
}

do_disk() {
  echo "== disk -> $REMOTE_ROOT on Render"
  if [ ${#DRY[@]} -gt 0 ]; then
    DRY_RUN=1 bin/rebuild-data-render.sh
  else
    CONFIRM=yes bin/rebuild-data-render.sh
  fi
}

RUNTIME_PAIRS=(
  "data/huayu|huayu"
  "data/textbook|textbook"
  "dict_and_corpora/dictionaries/makemeahanzi|dictionaries/makemeahanzi"
  "media/audio/textbook|media/audio/textbook"
)

RUNTIME_ARCHIVES=(
  "data/pronunciation/templates|pronunciation/templates.tar.gz"
)

RUNTIME_FILES=(
  "data/content_sources.json|content_sources.json"
  "data/fonts.json|fonts.json"
  "dict_and_corpora/dictionaries/simp_to_trad.txt|dictionaries/simp_to_trad.txt"
  "data/pronunciation/thresholds.json|pronunciation/thresholds.json"
  "data/pronunciation/inventory.json|pronunciation/inventory.json"
  "data/pronunciation/drills.json|pronunciation/drills.json"
  "data/pronunciation/axis_norms.json|pronunciation/axis_norms.json"
  "media/moe_audio/index.json|media/moe_audio/index.json"
  "media/moe_audio/notice.pdf|media/moe_audio/notice.pdf"
  "media/moe_audio/ATTRIBUTION.txt|media/moe_audio/ATTRIBUTION.txt"
  "media/moe_audio_words/index.json|media/moe_audio_words/index.json"
  "media/moe_audio_words/notice.pdf|media/moe_audio_words/notice.pdf"
  "media/moe_audio_words/ATTRIBUTION.txt|media/moe_audio_words/ATTRIBUTION.txt"
  "media/listening/manifest.json|media/listening/manifest.json"
)

do_runtime() {
  need R2_RUNTIME_BUCKET
  echo "== runtime -> s3://$R2_RUNTIME_BUCKET"

  local pair src dest
  for pair in "${RUNTIME_PAIRS[@]}"; do
    src="${pair%%|*}"
    dest="${pair##*|}"
    [ -d "$src" ] || {
      echo "   skip $src (absent)"
      continue
    }
    echo "   $src"
    r2 sync "$src" "s3://$R2_RUNTIME_BUCKET/$dest" --no-progress \
      --exclude '.*' --exclude '*/.*' ${DRY[@]+"${DRY[@]}"}
  done

  local digest
  for pair in "${RUNTIME_FILES[@]}"; do
    src="${pair%%|*}"
    dest="${pair##*|}"
    [ -f "$src" ] || {
      echo "   skip $src (absent)"
      continue
    }
    digest="$(sha_file "$src")"
    [ "$digest" != "$(remote_sha "$dest")" ] || {
      echo "   $src (unchanged)"
      continue
    }
    echo "   $src"
    [ ${#DRY[@]} -eq 0 ] || continue
    r2 cp "$src" "s3://$R2_RUNTIME_BUCKET/$dest" --no-progress \
      --metadata "sha256=$digest"
  done

  local archive
  for pair in "${RUNTIME_ARCHIVES[@]}"; do
    src="${pair%%|*}"
    dest="${pair##*|}"
    [ -d "$src" ] || {
      echo "   skip $src (absent)"
      continue
    }
    digest="$(sha_tree "$src")"
    [ "$digest" != "$(remote_sha "$dest")" ] || {
      echo "   $src (unchanged)"
      continue
    }
    echo "   $src -> $dest"
    [ ${#DRY[@]} -eq 0 ] || continue
    archive="$(mktemp -t taiwancards-runtime).tar.gz"
    COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata \
      -czf "$archive" -C "$(dirname "$src")" "$(basename "$src")"
    r2 cp "$archive" "s3://$R2_RUNTIME_BUCKET/$dest" --no-progress \
      --metadata "sha256=$digest"
    rm -f "$archive"
  done
}

[ $# -ge 1 ] || usage
target="$1"
shift
DRY=()
RSYNC_DRY=()
if [ "${1:-}" = "--dry-run" ]; then
  DRY=(--dryrun)
  RSYNC_DRY=(--dry-run)
fi

do_pull() {
  need R2_BUCKET
  echo "== pull <- s3://$R2_BUCKET"
  for dir in "${ARCHIVE_DIRS[@]}"; do
    echo "   $dir"
    mkdir -p "$dir"
    r2 sync "s3://$R2_BUCKET/$dir" "$dir" --no-progress ${DRY[@]+"${DRY[@]}"}
  done

  [ ${#DRY[@]} -eq 0 ] || return 0

  local file
  for file in "${UNPACKED_FROM_XZ[@]}"; do
    [ -f "$file" ] && continue
    [ -f "$file.xz" ] || {
      echo "   missing $file.xz; cannot restore $file" >&2
      continue
    }
    echo "   unpacking $file.xz"
    xz -dk "$file.xz"
  done
}

do_status() {
  need R2_BUCKET R2_MEDIA_BUCKET R2_ASSETS_BUCKET
  for bucket in "$R2_BUCKET" "$R2_MEDIA_BUCKET" "$R2_ASSETS_BUCKET"; do
    echo "== s3://$bucket"
    r2 ls "s3://$bucket" --recursive --summarize | tail -2 | sed 's/^/   /'
  done
}

case "$target" in
archive) do_archive ;;
media) do_media ;;
assets) do_assets ;;
runtime) do_runtime ;;
disk) do_disk ;;
pull) do_pull ;;
status) do_status ;;
all)
  do_archive
  do_media
  do_assets
  do_runtime
  ;;
*) usage ;;
esac
