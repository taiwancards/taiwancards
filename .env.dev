# Template for .env. Copy it, fill in what you need, never commit the result.
# Quote every value: KEY="value". dotenv, just and `set -a; . .env` all read this file.
# In production these are set on the host, not from a file.

# !REQUIRED TO BOOT!

# Signing key for cookies and sessions. Generate: bin/rails secret
SECRET_KEY_BASE=

# Postgres port for development and test.
PGPORT=


# !REQUIRED IN PRODUCTION ONLY!

# Postgres connection string. Development and test build one from PGPORT.
DATABASE_URL=

# Google OAuth client. The only way to sign in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 32-byte keys for encrypted columns. Generate: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=


# !OPTIONAL!
# Everything below degrades to a no-op when unset. The application boots and
# serves requests without any of it.

# Extra hostnames accepted by host authorization, comma separated.
APP_HOSTS=
# Canonical host used in generated links.
APP_HOST=
# Static ngrok domain for the local tunnel.
NGROK_DOMAIN=

# Where bulk data is read from. Defaults sit inside the repository.
DATA_ROOT=
CORPORA_DIR=
MEDIA_ROOT=
FONT_DIR=
PRONUNCIATION_DATA_PATH=

# Public base URLs for fonts, browser data and audio. Empty makes the
# application serve those files itself.
ASSETS_BASE_URL=
MEDIA_BASE_URL=

# Canonical addresses of the two deployed services. Only site:build needs them.
SITE_URL=
APP_URL=

# Seeds one administrator. Without ADMIN_EMAIL no administrator is created.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_GOOGLE_EMAIL=

# Per-connection guards in production. "0" disables them; the deploy scripts
# do that for migrations and imports.
PG_STATEMENT_TIMEOUT=
PG_LOCK_TIMEOUT=
# Any value keeps the content security policy in report-only mode.
CSP_REPORT_ONLY=
# Puma threads and worker processes.
RAILS_MAX_THREADS=
WEB_CONCURRENCY=

# Render service id and region, used by the content transfer scripts.
RENDER_SERVER=
RENDER_REGION=
# Render API token. Only the content deploy uses it, to request a redeploy.
RENDER_API_KEY=
# Production connection string used by the dump and restore tasks.
PROD_DATABASE_URL=

# Cloudflare cache. Guest pages are held by the shared cache for PUBLIC_SHARED_TTL
# seconds; the purge runs after a deploy that imported anything and whenever a
# content source is switched, so a licence change takes effect at once. Without
# the zone and token the purge is skipped and nothing else changes. The token
# needs one permission: Zone / Cache Purge / Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
PUBLIC_SHARED_TTL=
PUBLIC_STALE_TTL=

# Cloudflare R2: the cold archive, the runtime bucket and the two public buckets.
R2_ENDPOINT=
R2_BUCKET=
R2_MEDIA_BUCKET=
R2_ASSETS_BUCKET=
R2_RUNTIME_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Fetched at runtime by the sections that use them.
PTS_FEED_URL=
LRCLIB_HOST=
TEXTBOOK_AUDIO_BASE_URL=

# Donation button at the foot of the help page. It renders only when both the
# script and the account slug are set. DONATE_ORIGINS lists the other hosts the
# widget pulls from, comma separated; leave it empty to block them.
DONATE_SCRIPT_URL=
DONATE_SLUG=
DONATE_ORIGINS=


# OFFLINE CORPUS PIPELINE
# Read only by the scripts in the corpora repository. A running server never
# touches these. Publisher home pages and licences are listed in that
# repository's README.

# Dictionaries and reference tables.
MOE_CONCISED_DICT_URL=
MOE_REVISED_DICT_URL=
MOE_AUDIO_BASE_URL=
TBCL_GRAMMAR_URL=
TBCL_VOCAB_URL=
NAER_TERMS_BASE_URL=
MOI_NAMES_URL=
CNS11643_KAI_FONT_URL=
CNS11643_PROPERTIES_URL=
CNS11643_MAPPINGS_URL=
CNS11643_VOICE_URL=
XIAOXUE_CCR_BASE_URL=
MAKEMEAHANZI_DICTIONARY_URL=
MAKEMEAHANZI_GRAPHICS_URL=
HANZILOOKUP_DATA_URL=
OPENCC_ST_URL=
OPENCC_TS_URL=

# Corpora.
# JSONL of filtered web sentences, one object per line with "host" and "text".
# Read by build_web_runs.rb; produced outside this repository.
WEB_CORPUS=
LAW_CORPUS_URL=
NTPC_NEWS_CSV_URL=
NTPC_ACTIVITIES_CSV_URL=
COMMON_VOICE_BASE_URL=
LEGISLATIVE_TRANSCRIPT_BASE_URL=
PTT_GOSSIP_CORPUS_URL=
OPENSUBTITLES_URL=
TED2020_URL=
WIKIPEDIA_DUMP_URL=
WIKISOURCE_API_URL=
TTE_DATASET_URL=
VOCUS_SITEMAP_URL=

# Keys and endpoints for gated downloads.
YOUTUBE_API_URL=
YOUTUBE_API_KEY=
HF_TOKEN=
MOZILLA_DATA_COLLECTIVE_API_URL=
MOZILLA_DATA_COLLECTIVE_API_KEY=
COMMON_VOICE_DATASET_ID=

# User agent sent by every fetcher.
CORPUS_USER_AGENT=
